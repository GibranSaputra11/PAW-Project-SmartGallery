<%- include('partials/head', { title: title }) %>

<body class="bg-ivory text-ink min-h-screen flex flex-col rounded-none">

  <header class="sticky top-0 z-40 bg-milk/90 backdrop-blur-md border-b border-hairline">
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 group">
        <svg class="w-8 h-8 text-ink group-hover:scale-105 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        <span class="font-display text-2xl tracking-wider text-ink">SMART</span>
      </a>
      <span class="font-script text-muted text-xl -ml-6 -mt-2">Gallery</span>

      <nav class="hidden md:flex items-center gap-8 text-sm font-medium">
        <a href="/" class="text-muted hover:text-ink transition-colors">Home</a>
        <a href="/gallery" class="text-ink hover:text-charcoal transition-colors">Portofolio</a>
        <% if (session && session.userId) { %>
          <a href="/admin/dashboard" class="bg-stone text-ink px-4 py-2 border border-hairline hover:bg-cement transition-all font-semibold rounded-none">Dashboard Admin</a>
          <form action="/auth/logout" method="POST" class="inline">
            <button type="submit" class="text-muted hover:text-ink transition-colors">Logout</button>
          </form>
        <% } else { %>
          <a href="/auth/login" class="text-muted hover:text-ink transition-colors">Admin Login</a>
        <% } %>
      </nav>
    </div>
  </header>

  <main class="flex-1 max-w-7xl w-full mx-auto px-6 py-16">
    <div class="text-center mb-12">
      <h1 class="text-4xl sm:text-5xl font-display uppercase tracking-wide text-ink">Portofolio <span class="text-ink font-script normal-case text-3xl sm:text-4xl">Gallery</span></h1>
      <p class="text-muted text-sm mt-2">Koleksi dokumentasi profesional dari berbagai momen spesial.</p>
    </div>

    <!-- Filter Buttons -->
    <div class="flex flex-wrap justify-center gap-3 mb-12">
      <% categories.forEach(function(cat) { %>
        <button onclick="filterGallery('<%= cat %>')" class="cat-btn px-6 py-2.5 text-sm font-semibold transition-all border rounded-none <%= selectedCategory === cat ? 'bg-ink text-milk border-ink' : 'bg-milk text-muted border-hairline hover:border-ink hover:text-ink' %>" data-category="<%= cat %>">
          <%= cat %>
        </button>
      <% }); %>
    </div>

    <% if (galleries.length > 0) { %>
      <%
        // Distribusikan data ke 4 kolom agar tinggi selang-seling (2/3 & 4/5) bekerja secara visual
        const columns = [[], [], [], []];
        galleries.forEach(function(item, idx) {
          columns[idx % 4].push(item);
        });
      %>

      <!-- Gallery Outer-Aligned Staggered Grid (4 columns desktop, 2 tablet, 1 mobile) -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-4 items-start" id="gallery-grid">
        <% columns.forEach(function(colItems, colIdx) { %>
          <div class="flex flex-col gap-4">
            <% colItems.forEach(function(gallery, rowIdx) {
              // Kolom 0 & 2: [2/3, 4/5, ...] | Kolom 1 & 3: [4/5, 2/3, ...]
              const isOddCol = (colIdx === 0 || colIdx === 2);
              const aspectClass = isOddCol
                ? (rowIdx % 2 === 0 ? 'aspect-[2/3]' : 'aspect-[4/5]')
                : (rowIdx % 2 === 0 ? 'aspect-[4/5]' : 'aspect-[2/3]');

              const formattedDate = gallery.eventDate
                ? new Date(gallery.eventDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'long', year: 'numeric' })
                : '';
            %>
              <article
                class="group relative bg-milk border border-hairline <%= aspectClass %> w-full overflow-hidden gallery-card cursor-pointer rounded-none"
                data-category="<%= gallery.category %>"
                data-image="<%= gallery.imageUrl %>"
                data-title="<%= gallery.title %>"
                data-date="<%= formattedDate %>"
                data-video="<%= gallery.videoUrl || '' %>"
                onclick="openLightbox(this)">

                <img src="<%= gallery.imageUrl %>" alt="<%= gallery.title %>" class="w-full h-full object-cover object-top group-hover:scale-105 transition-transform duration-500 rounded-none" loading="lazy">
                
                <div class="absolute inset-0 bg-gradient-to-t from-ivory/95 via-ivory/40 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex flex-col justify-end p-5">
                  <span class="text-xs font-bold text-ink uppercase tracking-wider mb-1 bg-stone/80 px-2 py-0.5 w-fit rounded-none"><%= gallery.category %></span>
                  <h3 class="text-lg font-bold text-ink line-clamp-1"><%= gallery.title %></h3>
                  <p class="text-xs text-muted mt-0.5"><%= formattedDate %></p>
                  <% if (gallery.videoUrl) { %>
                    <span class="mt-2 inline-flex items-center gap-1.5 text-xs font-bold text-milk bg-ink px-3 py-1 w-fit rounded-none">
                      <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                      Video
                    </span>
                  <% } %>
                </div>

                <% if (gallery.videoUrl) { %>
                  <div class="absolute top-3 right-3 bg-ink text-milk text-xs font-bold px-2.5 py-1 rounded-none flex items-center gap-1">
                    <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 10l4.553-2.276A1 1 0 0121 8.618v6.764a1 1 0 01-1.447.894L15 14M5 18h8a2 2 0 002-2V8a2 2 0 00-2-2H5a2 2 0 00-2 2v8a2 2 0 002 2z"></path></svg>
                    <span>VIDEO</span>
                  </div>
                <% } %>
              </article>
            <% }); %>
          </div>
        <% }); %>
      </div>
    <% } else { %>
      <div class="text-center py-20 border border-hairline bg-milk">
        <svg class="w-16 h-16 mx-auto text-muted/30 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
        <h3 class="text-xl font-semibold text-ink mb-2">Belum Ada Galeri</h3>
        <p class="text-muted text-sm">Portofolio akan ditampilkan di sini setelah admin menambahkan foto/video.</p>
      </div>
    <% } %>
  </main>

  <!-- Lightbox Modal -->
  <div id="lightbox-modal" class="fixed inset-0 z-50 bg-ink/80 backdrop-blur-sm hidden items-center justify-center p-4 sm:p-8">
    <div class="bg-milk border border-hairline w-full max-w-4xl max-h-[90vh] flex flex-col relative rounded-none overflow-hidden">
      <div class="flex items-center justify-between px-6 py-4 border-b border-hairline bg-stone">
        <div>
          <span id="lightbox-category" class="text-xs font-bold text-ink uppercase tracking-wider bg-alabaster px-2 py-0.5 border border-hairline rounded-none"></span>
          <h3 id="lightbox-title" class="text-lg font-display uppercase tracking-wide text-ink mt-1"></h3>
        </div>
        <button onclick="closeLightbox()" class="text-muted hover:text-ink p-2 transition-colors" aria-label="Tutup">
          <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>

      <div class="p-6 flex-1 overflow-y-auto flex flex-col items-center justify-center bg-ivory">
        <img id="lightbox-img" src="" alt="Lightbox Image" class="max-h-[60vh] w-auto object-contain rounded-none border border-hairline">
        
        <div id="lightbox-video-container" class="w-full aspect-video hidden mt-4">
          <iframe id="lightbox-iframe" src="" class="w-full h-full border border-hairline" allowfullscreen></iframe>
        </div>

        <p id="lightbox-date" class="text-xs text-muted mt-4 font-mono"></p>
        
        <div id="lightbox-video-link-container" class="mt-4 hidden">
          <a id="lightbox-video-btn" href="" target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 bg-ink hover:bg-charcoal text-milk font-semibold py-2.5 px-6 text-sm rounded-none border border-ink transition-colors">
            <span>Buka Tautan Video</span>
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 6H6a2 2 0 00-2 2v10a2 2 0 002 2h10a2 2 0 002-2v-4M14 4h6m0 0v6m0-6L10 14"></path></svg>
          </a>
        </div>
      </div>
    </div>
  </div>

<script>
  function filterGallery(category) {
    document.querySelectorAll('.cat-btn').forEach(btn => {
      if (btn.dataset.category === category) {
        btn.className = 'cat-btn px-6 py-2.5 text-sm font-semibold transition-all border rounded-none bg-ink text-milk border-ink';
      } else {
        btn.className = 'cat-btn px-6 py-2.5 text-sm font-semibold transition-all border rounded-none bg-milk text-muted border-hairline hover:border-ink hover:text-ink';
      }
    });

    document.querySelectorAll('.gallery-card').forEach(card => {
      if (category === 'Semua' || card.dataset.category === category) {
        card.style.display = 'block';
      } else {
        card.style.display = 'none';
      }
    });
  }

  function openLightbox(cardEl) {
    const imageUrl = cardEl.dataset.image;
    const title = cardEl.dataset.title;
    const category = cardEl.dataset.category;
    const date = cardEl.dataset.date;
    const videoUrl = cardEl.dataset.video;

    const modal = document.getElementById('lightbox-modal');
    const img = document.getElementById('lightbox-img');
    const titleEl = document.getElementById('lightbox-title');
    const catEl = document.getElementById('lightbox-category');
    const dateEl = document.getElementById('lightbox-date');
    const videoContainer = document.getElementById('lightbox-video-container');
    const iframe = document.getElementById('lightbox-iframe');
    const videoLinkContainer = document.getElementById('lightbox-video-link-container');
    const videoBtn = document.getElementById('lightbox-video-btn');

    img.src = imageUrl;
    titleEl.textContent = title;
    catEl.textContent = category;
    dateEl.textContent = date ? `Tanggal Acara: ${date}` : '';

    if (videoUrl && videoUrl !== 'null' && videoUrl !== '') {
      let embedUrl = videoUrl;
      if (videoUrl.includes('watch?v=')) {
        embedUrl = videoUrl.replace('watch?v=', 'embed/').split('&')[0];
      } else if (videoUrl.includes('youtu.be/')) {
        embedUrl = videoUrl.replace('youtu.be/', 'www.youtube.com/embed/').split('?')[0];
      } else if (videoUrl.includes('youtube.com/shorts/')) {
        embedUrl = videoUrl.replace('youtube.com/shorts/', 'youtube.com/embed/').split('?')[0];
      }
      iframe.src = embedUrl;
      videoContainer.classList.remove('hidden');
      videoLinkContainer.classList.remove('hidden');
      videoBtn.href = videoUrl;
    } else {
      iframe.src = '';
      videoContainer.classList.add('hidden');
      videoLinkContainer.classList.add('hidden');
    }

    modal.classList.remove('hidden');
    modal.classList.add('flex');
  }

  function closeLightbox() {
    const modal = document.getElementById('lightbox-modal');
    const iframe = document.getElementById('lightbox-iframe');
    iframe.src = '';
    modal.classList.remove('flex');
    modal.classList.add('hidden');
  }

  // Close modal on background click
  document.getElementById('lightbox-modal').addEventListener('click', function(e) {
    if (e.target === this) {
      closeLightbox();
    }
  });

  // Close modal on Escape key
  document.addEventListener('keydown', function(e) {
    if (e.key === 'Escape') {
      closeLightbox();
    }
  });
</script>

<%- include('partials/footer') %>