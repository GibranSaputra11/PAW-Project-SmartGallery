<!DOCTYPE html>
<html lang="id" class="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title><%= typeof title !== 'undefined' ? title : 'Smart Gallery' %></title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:ital,wght@0,300..800;1,300..800&family=JetBrains+Mono:wght@400;600&family=Caveat:wght@700&display=swap" rel="stylesheet">
  <script src="https://cdn.tailwindcss.com"></script>
  <script>
    tailwind.config = {
      darkMode: 'class',
      theme: {
        extend: {
          colors: {
            ivory: '#F7F5F0',
            milk: '#FCFBF9',
            alabaster: '#F0EDE6',
            stone: '#E5E2DC',
            cement: '#D6D2C9',
            hairline: '#BDB9AF',
            numeral: '#A39F96',
            muted: '#5E5B55',
            ink: '#121212',
            charcoal: '#292929',
            street: '#121212',
            cardbg: '#FCFBF9',
            paper: '#121212',
            wa: '#25D366'
          },
          fontFamily: {
            sans: ['"Plus Jakarta Sans"', 'Inter', 'sans-serif'],
            mono: ['"JetBrains Mono"', 'monospace'],
            display: ['"Plus Jakarta Sans"', 'sans-serif'],
            script: ['Caveat', 'cursive']
          }
        }
      }
    }
  </script>
  <style>
    :root {
      --bg-canvas-ivory: #F7F5F0;
      --surface-milk: #FCFBF9;
      --surface-alabaster: #F0EDE6;
      --surface-stone: #E5E2DC;
      --surface-cement: #D6D2C9;
      --border-hairline: #BDB9AF;
      --text-numeral: #A39F96;
      --text-secondary: #5E5B55;
      --ink-primary: #121212;
      --ink-hover: #292929;
      --radius-strict: 0px;
    }
    *, *::before, *::after {
      border-radius: var(--radius-strict) !important;
    }
    body {
      background-color: var(--bg-canvas-ivory);
      color: var(--ink-primary);
      font-family: 'Plus Jakarta Sans', sans-serif;
    }
  </style>
</head>