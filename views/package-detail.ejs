<%- include('partials/head', { title: title }) %>

<body class="bg-ivory text-ink min-h-screen flex flex-col">

  <!-- Header -->
  <header class="sticky top-0 z-50 bg-milk/80 backdrop-blur-md border-b border-hairline">
    <div class="max-w-4xl mx-auto px-6 py-4 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 group">
        <svg class="w-8 h-8 text-ink group-hover:scale-105 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        <span class="font-display text-xl tracking-wider text-ink">SMART</span>
      </a>
      <span class="font-script text-ink text-lg -ml-4 -mt-1">Gallery</span>
      <a href="/" class="text-sm font-semibold text-ink hover:text-muted transition-colors flex items-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
        Kembali ke Pricelist
      </a>
    </div>
  </header>

  <!-- Main Content -->
  <main class="flex-1 max-w-4xl w-full mx-auto px-6 py-12">
    <div class="bg-milk rounded-2xl p-6 sm:p-8 border border-hairline shadow-sm">
      
      <div class="flex flex-wrap items-center justify-between gap-4 mb-6">
        <span class="text-xs font-bold text-ink bg-stone px-3.5 py-1.5 rounded-xl uppercase tracking-wider">
          <%= pkg.category %>
        </span>
        <span class="text-sm font-semibold text-muted bg-stone px-3 py-1.5 rounded-xl">
          Durasi: <%= pkg.duration %>
        </span>
      </div>

      <h1 class="text-3xl sm:text-4xl font-display uppercase tracking-wide text-ink"><%= pkg.name %></h1>
      <p class="mt-4 text-base sm:text-lg text-muted leading-relaxed"><%= pkg.description %></p>

      <div class="mt-8 p-6 bg-stone/30 rounded-xl border border-hairline flex flex-col sm:flex-row items-start sm:items-center justify-between gap-4">
        <div>
          <p class="text-xs font-bold text-muted uppercase tracking-wider">Estimasi Biaya Paket</p>
          <p class="text-3xl sm:text-4xl font-black text-ink mt-1">
            Rp <%= pkg.price.toLocaleString('id-ID') %>
          </p>
        </div>
        <a href="https://wa.me/6281234567890?text=Halo%2C%20saya%20tertarik%20dengan%20<%= encodeURIComponent(pkg.name) %>" target="_blank" class="w-full sm:w-auto bg-ink hover:bg-charcoal text-milk font-semibold py-3.5 px-8 rounded-xl transition-all text-center border border-ink shadow-sm">
          Pesan via WhatsApp
        </a>
      </div>

      <div class="grid md:grid-cols-2 gap-8 mt-10 pt-10 border-t border-hairline">
        <div>
          <h3 class="text-xs font-bold text-ink uppercase tracking-wider mb-4">Fasilitas Termasuk:</h3>
          <ul class="space-y-3">
            <% if (pkg.features && pkg.features.length > 0) { %>
              <% pkg.features.forEach(function(c) { %>
                <li class="flex items-start gap-3 text-muted text-sm">
                  <div class="w-5 h-5 text-emerald-500 shrink-0 mt-0.5 flex items-center justify-center">
                    <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.690h3.462c.969 0 1.371 1.24.588 1.810l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.690l1.07-3.292z"/></svg>
                  </div>
                  <span><%= c %></span>
                </li>
              <% }); %>
            <% } %>
          </ul>
        </div>

        <% if (pkg.notIncluded && pkg.notIncluded.length > 0) { %>
          <div>
            <h3 class="text-xs font-bold text-muted uppercase tracking-wider mb-4">Tidak Termasuk:</h3>
            <ul class="space-y-3">
              <% pkg.notIncluded.forEach(function(nc) { %>
                <li class="flex items-start gap-3 text-muted/70 text-sm">
                  <svg class="w-5 h-5 text-rose-500 shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                  <span><%= nc %></span>
                </li>
              <% }); %>
            </ul>
          </div>
        <% } %>
      </div>

      <!-- Cocok Untuk Section -->
      <section class="mt-10 pt-10 border-t border-hairline">
        <h3 class="text-xs font-bold text-ink uppercase tracking-wider mb-4 flex items-center gap-2">
          <svg class="w-5 h-5 text-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
          Cocok Untuk
        </h3>
        <div class="flex flex-wrap gap-2">
          <% if (pkg.category === 'Wisuda') { %>
            <span class="bg-stone text-ink px-4 py-1.5 rounded-full text-sm font-medium font-mono border border-hairline">Mahasiswa Wisuda</span>
            <span class="bg-stone text-ink px-4 py-1.5 rounded-full text-sm font-medium font-mono border border-hairline">Orang Tua & Keluarga</span>
          <% } else if (pkg.category === 'Prewedding') { %>
            <span class="bg-stone text-ink px-4 py-1.5 rounded-full text-sm font-medium font-mono border border-hairline">Pasangan Menikah</span>
            <span class="bg-stone text-ink px-4 py-1.5 rounded-full text-sm font-medium font-mono border border-hairline">Pre-wedding Photoshoot</span>
          <% } else if (pkg.category === 'Wedding') { %>
            <span class="bg-stone text-ink px-4 py-1.5 rounded-full text-sm font-medium font-mono border border-hairline">Acara Akad & Resepsi</span>
            <span class="bg-stone text-ink px-4 py-1.5 rounded-full text-sm font-medium font-mono border border-hairline">Full Day Coverage</span>
          <% } %>
        </div>
      </section>

      <!-- Popular Badge -->
      <% if (pkg.popular) { %>
        <div class="mt-6 p-4 bg-amber-50 border border-amber-200 rounded-xl">
          <p class="text-sm text-amber-800 flex items-center gap-2">
            <svg class="w-5 h-5 shrink-0" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.690h3.462c.969 0 1.371 1.24.588 1.810l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.690l1.07-3.292z"/></svg>
            <strong>Paling Populer</strong> — Paket ini paling diminati klien kami.
          </p>
        </div>
      <% } %>
    </div>
  </main>

  <!-- Footer -->
  <footer class="bg-milk border-t border-hairline py-8 mt-auto">
    <div class="max-w-4xl mx-auto px-6 text-center text-sm text-muted">
      <p>&copy; <%= new Date().getFullYear() %> SMART Gallery — Professional Photography & Videography Services. All rights reserved.</p>
    </div>
  </footer>

</body>
</html>