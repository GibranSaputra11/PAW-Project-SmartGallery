<%- include('partials/head', { title: title }) %>

<body class="bg-street text-paper min-h-screen flex flex-col selection:bg-accent selection:text-street">

  <header class="sticky top-0 z-40 bg-street/90 backdrop-blur-md border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 group">
        <svg class="w-8 h-8 text-accent group-hover:scale-105 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        <span class="font-display text-2xl tracking-wider text-paper">SMART</span>
      </a>
      <span class="font-script text-accent text-xl -ml-6 -mt-2">Gallery</span>

      <nav class="hidden md:flex items-center gap-8 text-sm font-medium">
        <a href="/" class="text-muted hover:text-paper transition-colors">Pricelist</a>
        <a href="/gallery" class="text-muted hover:text-paper transition-colors">Portofolio</a>
        <% if (session && session.userId) { %>
          <a href="/admin/dashboard" class="bg-accent/10 text-accent px-4 py-2 rounded-xl border border-accent/20 hover:bg-accent/20 transition-all font-semibold">Dashboard Admin</a>
          <form action="/auth/logout" method="POST" class="inline">
            <button type="submit" class="text-muted hover:text-red-400 transition-colors">Logout</button>
          </form>
        <% } else { %>
          <a href="/auth/login" class="text-muted hover:text-paper transition-colors">Admin Login</a>
        <% } %>
      </nav>
    </div>
  </header>

  <main class="flex-1 max-w-3xl w-full mx-auto px-6 py-16">
    <div class="mb-10">
      <a href="/" class="inline-flex items-center gap-2 text-muted hover:text-accent transition-colors text-sm font-medium mb-6">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 19l-7-7 7-7"></path></svg>
        Kembali ke Pricelist
      </a>
      <div class="flex items-center gap-2 mb-4">
        <span class="text-xs font-bold text-accent bg-accent/10 px-3 py-1.5 rounded-xl uppercase tracking-wider"><%= pkg.category %></span>
        <span class="text-xs font-semibold text-muted bg-street px-3 py-1.5 rounded-xl border border-slate-800"><%= pkg.duration %></span>
      </div>
      <h1 class="text-3xl sm:text-4xl font-display uppercase tracking-wide text-paper"><%= pkg.name %></h1>
      <% if (pkg.popular) { %>
        <span class="inline-block mt-2 bg-accent/10 text-accent text-xs font-extrabold tracking-wider uppercase px-3 py-1 rounded-full">Paling Populer</span>
      <% } %>
    </div>

    <div class="bg-cardbg rounded-3xl p-8 border border-slate-800 space-y-8">
      <section>
        <h2 class="text-xl font-semibold text-paper mb-4 flex items-center gap-2">
          <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          Deskripsi Paket
        </h2>
        <p class="text-muted leading-relaxed text-base"><%= pkg.description %></p>
      </section>

      <section class="pt-6 border-t border-slate-800">
        <h2 class="text-xl font-semibold text-paper mb-4 flex items-center gap-2">
          <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3-.895 3-2-1.343-2-3-2z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16"></path></svg>
          Harga & Durasi
        </h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-6">
          <div class="bg-street rounded-2xl p-6 border border-slate-800">
            <p class="text-xs font-bold text-muted uppercase tracking-wider mb-2">Mulai dari</p>
            <p class="text-4xl font-black text-paper">Rp <%= pkg.price.toLocaleString('id-ID') %></p>
          </div>
          <div class="bg-street rounded-2xl p-6 border border-slate-800">
            <p class="text-xs font-bold text-muted uppercase tracking-wider mb-2">Durasi</p>
            <p class="text-2xl font-bold text-accent"><%= pkg.duration %></p>
          </div>
        </div>
      </section>

      <section class="pt-6 border-t border-slate-800">
        <h2 class="text-xl font-semibold text-paper mb-4 flex items-center gap-2">
          <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          Fasilitas Termasuk
        </h2>
        <ul class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <% pkg.features.forEach(function(c) { %>
            <li class="flex items-center gap-3 bg-street rounded-xl p-4 border border-slate-800">
              <div class="w-10 h-10 rounded-xl bg-accent/10 border border-accent/20 flex items-center justify-center shrink-0">
                <svg class="w-5 h-5 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
              </div>
              <span class="text-paper text-sm"><%= c %></span>
            </li>
          <% }); %>
        </ul>
      </section>

      <% if (pkg.notIncluded && pkg.notIncluded.length > 0) { %>
      <section class="pt-6 border-t border-slate-800">
        <h2 class="text-xl font-semibold text-paper mb-4 flex items-center gap-2">
          <svg class="w-6 h-6 text-amber-500" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
          Tidak Termasuk dalam Paket
        </h2>
        <ul class="space-y-2">
          <% pkg.notIncluded.forEach(function(nc) { %>
            <li class="flex items-center gap-3 text-sm text-muted/70 bg-street/50 rounded-xl p-3 border border-slate-800/50">
              <svg class="w-5 h-5 text-amber-500 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m-2 2l2 2m-2-2l-2 2"></path></svg>
              <span><%= nc %></span>
            </li>
          <% }); %>
        </ul>
      </section>
      <% } %>

      <section class="pt-6 border-t border-slate-800">
        <h2 class="text-xl font-semibold text-paper mb-4 flex items-center gap-2">
          <svg class="w-6 h-6 text-accent" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z"></path></svg>
          Cocok Untuk
        </h2>
        <div class="flex flex-wrap gap-2">
          <% if (pkg.category === 'Wisuda') { %>
            <span class="bg-accent/10 text-accent px-4 py-1.5 rounded-full text-sm font-medium border border-accent/20">Mahasiswa Wisuda</span>
            <span class="bg-accent/10 text-accent px-4 py-1.5 rounded-full text-sm font-medium border border-accent/20">Orang Tua & Keluarga</span>
          <% } else if (pkg.category === 'Prewedding') { %>
            <span class="bg-accent/10 text-accent px-4 py-1.5 rounded-full text-sm font-medium border border-accent/20">Pasangan Menikah</span>
            <span class="bg-accent/10 text-accent px-4 py-1.5 rounded-full text-sm font-medium border border-accent/20">Pre-wedding Photoshoot</span>
          <% } else if (pkg.category === 'Wedding') { %>
            <span class="bg-accent/10 text-accent px-4 py-1.5 rounded-full text-sm font-medium border border-accent/20">Acara Akad & Resepsi</span>
            <span class="bg-accent/10 text-accent px-4 py-1.5 rounded-full text-sm font-medium border border-accent/20">Full Day Coverage</span>
          <% } %>
        </div>
      </section>
    </div>

    <div class="mt-8 flex flex-col sm:flex-row gap-4">
      <a href="https://wa.me/6281234567890?text=Halo%2C%20saya%20tertarik%20dengan%20<%= encodeURIComponent(pkg.name) %>" target="_blank" class="flex-1 bg-wa hover:bg-wa/90 text-street font-bold py-4 px-8 rounded-xl text-center transition-colors shadow-sm flex items-center justify-center gap-2 text-base">
        <svg class="w-5 h-5" fill="currentColor" viewBox="0 0 24 24"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.095 3.2 5.077 4.487.709.306 1.263.489 1.694.625.712.227 1.36.194 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378 9.86 9.86 0 01-1.379-5.031h-.003a9.87 9.87 0 015.031-1.378 9.86 9.86 0 011.379 5.031h.003c0 2.734-1.204 5.23-3.022 6.76"/></svg>
        Pesan via WhatsApp
      </a>
      <a href="/" class="flex-1 bg-street hover:bg-slate-800 text-paper font-semibold py-4 px-8 rounded-xl text-center border border-slate-800 transition-colors text-base">
        Lihat Paket Lainnya
      </a>
    </div>
  </main>

<%- include('partials/footer') %>