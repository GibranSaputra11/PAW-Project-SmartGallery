<%- include('partials/head', { judul: judul }) %>
<body class="bg-slate-50 text-slate-900 font-sans antialiased flex flex-col min-h-screen justify-between">

  <!-- Header -->
  <header class="max-w-4xl mx-auto px-6 py-6 w-full">
    <a href="/" class="text-xl font-black tracking-tight text-indigo-600 flex items-center gap-2">
      <svg class="w-7 h-7" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path>
      </svg>
      <%= namaAplikasi %>
    </a>
  </header>

  <!-- Main Content -->
  <main class="max-w-4xl mx-auto px-6 text-center py-20 flex-1">
    <div class="bg-white rounded-3xl p-12 shadow-sm border border-slate-200">
      <div class="w-16 h-16 mx-auto mb-6 bg-slate-100 rounded-2xl flex items-center justify-center">
        <svg class="w-8 h-8 text-slate-300" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M9.172 16.172a4 4 0 015.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path>
        </svg>
      </div>
      <h1 class="text-6xl font-black text-slate-900 mb-3">404</h1>
      <p class="text-2xl font-bold text-slate-700 mb-2">Paket Tidak Ditemukan</p>
      <p class="text-slate-500 mb-8 max-w-md mx-auto">
        Maaf, paket layanan yang Anda cari tidak tersedia atau mungkin sudah tidak dipasarkan lagi.
      </p>
      <a href="/" class="inline-block bg-indigo-600 hover:bg-indigo-700 text-white font-bold px-8 py-3.5 rounded-xl transition-colors shadow-sm">
        Kembali ke Pricelist
      </a>
    </div>
  </main>

  <!-- Footer -->
  <footer class="bg-white border-t border-slate-200 py-10 mt-auto">
    <div class="max-w-4xl mx-auto px-6 text-center text-sm text-slate-500">
      <p>&copy; <%= new Date().getFullYear() %> <%= namaAplikasi %> — Professional Photography & Videography Services. All rights reserved.</p>
    </div>
  </footer>

</body>
</html>