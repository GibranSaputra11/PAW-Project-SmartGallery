<%- include('partials/head', { title: title }) %>

<body class="bg-ivory text-ink min-h-screen flex flex-col">

  <!-- Header / Navbar -->
  <header class="sticky top-0 z-40 bg-milk/90 backdrop-blur-md border-b border-hairline">
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
      <a href="/" class="flex items-center gap-2 group">
        <svg class="w-8 h-8 text-ink group-hover:scale-105 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        <span class="font-display text-2xl tracking-wider text-ink">SMART</span>
      </a>
      <span class="font-script text-muted text-xl -ml-6 -mt-2">Gallery</span>

      <nav class="hidden md:flex items-center gap-8 text-sm font-medium">
        <a href="/" class="text-ink hover:text-charcoal transition-colors">Home</a>
        <a href="/gallery" class="text-muted hover:text-ink transition-colors">Portofolio</a>
        <% if (session && session.userId) { %>
          <a href="/admin/dashboard" class="bg-stone text-ink px-4 py-2 border border-hairline hover:bg-cement transition-all font-semibold">Dashboard Admin</a>
          <form action="/auth/logout" method="POST" class="inline">
            <button type="submit" class="text-muted hover:text-ink transition-colors">Logout</button>
          </form>
        <% } else { %>
          <a href="/auth/login" class="text-muted hover:text-ink transition-colors">Admin Login</a>
        <% } %>
      </nav>
    </div>
  </header>

  <!-- Hero Section -->
  <section class="max-w-7xl mx-auto px-6 pt-20 pb-16 text-center relative">
    <div class="absolute -top-10 left-1/2 -translate-x-1/2 w-96 h-96 bg-stone/50 rounded-full blur-3xl pointer-events-none"></div>
    
    <div class="inline-flex items-center gap-2 bg-milk border border-hairline text-ink text-xs font-bold uppercase tracking-widest px-4 py-2 mb-6">
      <span class="w-2 h-2 rounded-full bg-ink animate-pulse"></span>
      Instant Price & AI Assistant Online 24/7
    </div>

    <h1 class="text-6xl sm:text-7xl md:text-8xl font-display tracking-wide uppercase text-ink">
      SMART <span class="text-ink font-script normal-case text-5xl sm:text-6xl md:text-7xl">Gallery</span>
    </h1>
    
    <p class="mt-6 text-lg sm:text-xl max-w-2xl mx-auto text-muted font-normal leading-relaxed">
      Instant Price, Unforgettable Moments. Solusi cepat sewa jasa fotografi & videografi profesional untuk wisuda, prewedding, dan wedding Anda.
    </p>

    <div class="mt-10 flex flex-col sm:flex-row items-center justify-center gap-4">
      <button onclick="toggleChatbot()" class="w-full sm:w-auto bg-ink hover:bg-charcoal text-milk font-bold px-8 py-4 transition-all text-base border border-ink flex items-center justify-center gap-3">
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
        Tanya Harga & Jadwal
      </button>
      <a href="#pricelist" class="w-full sm:w-auto bg-milk hover:bg-alabaster text-ink font-semibold px-8 py-4 border border-hairline transition-all text-center text-base">
        Lihat Daftar Pricelist
      </a>
    </div>
  </section>

  <!-- Pricelist Section (Popular Only) -->
  <section id="pricelist" class="max-w-7xl mx-auto px-6 py-16">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-display uppercase tracking-wide text-ink">Pricelist & Paket Layanan Pilihan</h2>
      <p class="text-muted text-sm mt-2">Pilihan paket favorit dan terlaris untuk momen spesial Anda.</p>
    </div>

    <!-- Package Cards Grid (Popular Only) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-6" id="package-grid">
      <% popularPackages.forEach(function(item) { %>
        <div class="package-card bg-milk p-6 border border-ink ring-2 ring-ink/20 relative flex flex-col hover:border-ink transition-all duration-300" data-category="<%= item.category %>">
          
          <span class="absolute -top-3 left-1/2 -translate-x-1/2 bg-ink text-milk text-xs font-extrabold tracking-wider uppercase px-3 py-1">
            Paling Populer
          </span>

          <div class="flex-1">
            <div class="flex items-center justify-between gap-2 mb-3">
              <span class="text-xs font-bold text-ink bg-stone px-2.5 py-1 uppercase tracking-wider"><%= item.category %></span>
              <span class="text-xs font-semibold text-muted bg-milk px-2.5 py-1 border border-hairline"><%= item.duration %></span>
            </div>

            <h3 class="text-xl font-display uppercase tracking-wide text-ink"><%= item.name %></h3>
            <p class="mt-2 text-muted text-sm leading-relaxed line-clamp-2"><%= item.description %></p>

            <div class="mt-4 pt-4 border-t border-hairline">
              <p class="text-xs font-bold text-muted uppercase tracking-wider">Mulai dari</p>
              <p class="text-2xl font-black text-ink mt-1 font-mono">
                Rp <%= item.price.toLocaleString('id-ID') %>
              </p>
            </div>

            <div class="mt-4 space-y-2">
              <p class="text-xs font-bold text-ink uppercase tracking-wider">Fasilitas Termasuk:</p>
              <ul class="space-y-1.5">
                <% item.features.forEach(function(c) { %>
                  <li class="flex items-start gap-2 text-sm text-muted">
                    <svg class="w-4 h-4 text-ink shrink-0 mt-0.5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M5 13l4 4L19 7"></path></svg>
                    <span><%= c %></span>
                  </li>
                <% }); %>
              </ul>
            </div>

            <% if (item.notIncluded && item.notIncluded.length > 0) { %>
              <div class="mt-3 pt-3 border-t border-hairline/50">
                <p class="text-xs font-bold text-muted/60 uppercase tracking-wider mb-1">Tidak Termasuk:</p>
                <ul class="space-y-1">
                  <% item.notIncluded.forEach(function(nc) { %>
                    <li class="flex items-center gap-2 text-xs text-muted/60">
                      <svg class="w-3 h-3 text-muted shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
                      <span><%= nc %></span>
                    </li>
                  <% }); %>
                </ul>
              </div>
            <% } %>
          </div>

          <div class="mt-6 pt-4 border-t border-hairline flex gap-2">
            <a href="/paket/<%= item.id %>" class="w-full text-center bg-milk hover:bg-alabaster text-ink font-semibold py-2.5 px-3 border border-hairline transition-colors text-sm">
              Detail
            </a>
            <a href="https://wa.me/6281234567890?text=Halo%2C%20saya%20tertarik%20dengan%20<%= encodeURIComponent(item.name) %>" target="_blank" class="w-full text-center bg-ink hover:bg-charcoal text-milk font-bold py-2.5 px-3 transition-colors text-sm flex items-center justify-center gap-1.5 border border-ink">
              <span>WA</span>
            </a>
          </div>

        </div>
      <% }); %>
    </div>

    <!-- View All Packages Button -->
    <div class="text-center mt-12">
      <a href="/paket" class="inline-flex items-center gap-2 bg-ink hover:bg-charcoal text-milk font-semibold py-3.5 px-8 transition-all text-sm border border-ink shadow-sm">
        <span>Lihat Semua Paket Lainnya</span>
        <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M17 8l4 4m0 0l-4 4m4-4H3"></path></svg>
      </a>
    </div>
  </section>

  <!-- Gallery Section -->
  <section class="max-w-7xl mx-auto px-6 py-16 border-t border-hairline">
    <div class="flex flex-col sm:flex-row items-center justify-between gap-4 mb-12">
      <div>
        <h2 class="text-3xl sm:text-4xl font-display uppercase tracking-wide text-ink">Portofolio Terbaru</h2>
        <p class="text-muted text-sm mt-2">Koleksi dokumentasi pilihan dari berbagai acara.</p>
      </div>
      <a href="/gallery" class="text-ink hover:underline font-semibold text-sm flex items-center gap-1">
        Lihat Semua Galeri &rarr;
      </a>
    </div>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
      <% galleries.forEach(function(gallery) { %>
        <div class="group relative bg-milk border border-hairline aspect-[4/3] overflow-hidden">
          <img src="<%= gallery.imageUrl %>" alt="<%= gallery.title %>" class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500">
          <div class="absolute inset-0 bg-gradient-to-t from-ivory/90 via-ivory/30 to-transparent opacity-0 group-hover:opacity-100 transition-opacity flex flex-col justify-end p-6">
            <span class="text-xs font-bold text-ink uppercase tracking-wider mb-1"><%= gallery.category %></span>
            <h4 class="text-lg font-bold text-ink"><%= gallery.title %></h4>
            <% if (gallery.videoUrl) { %>
              <a href="<%= gallery.videoUrl %>" target="_blank" class="mt-3 inline-flex items-center gap-2 text-xs font-semibold text-milk bg-ink px-4 py-2 w-fit">
                Tonton Video
              </a>
            <% } %>
          </div>
          <% if (gallery.videoUrl) { %>
            <div class="absolute top-3 right-3 bg-ink text-milk text-xs font-bold px-2 py-1">VIDEO</div>
          <% } %>
        </div>
      <% }); %>
    </div>
  </section>

  <!-- Testimonials Section -->
  <section class="max-w-7xl mx-auto px-6 py-16 border-t border-hairline">
    <div class="text-center mb-12">
      <h2 class="text-3xl sm:text-4xl font-display uppercase tracking-wide text-ink">Testimoni Klien</h2>
      <p class="text-muted text-sm mt-2">Kepuasan klien adalah prioritas utama kami.</p>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
      <% testimonials.forEach(function(t) { %>
        <div class="bg-milk p-8 border border-hairline flex flex-col justify-between relative">
          <div class="flex items-center gap-1 mb-4 text-ink">
            <% for(let i=0; i < t.rating; i++) { %>
              <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.690h3.462c.969 0 1.371 1.24.588 1.810l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.690l1.07-3.292z"/></svg>
            <% } %>
          </div>
          <p class="font-script text-xl text-ink/90 leading-relaxed mb-6">"<%= t.message %>"</p>
          <div class="pt-4 border-t border-hairline flex items-center justify-between">
            <span class="font-bold text-sm text-ink"><%= t.clientName %></span>
            <span class="text-xs text-muted">Klien Terverifikasi</span>
          </div>
        </div>
      <% }); %>
    </div>
  </section>

  <!-- Floating AI Chatbot Widget -->
  <div id="chat-widget" class="fixed bottom-6 right-6 z-50 flex flex-col items-end">
    <!-- Chat Button -->
    <button onclick="toggleChatbot()" id="chat-toggle-btn" class="bg-ink hover:bg-charcoal text-milk px-6 py-3 rounded-none shadow-2xl flex items-center justify-center gap-2 transition-transform hover:scale-105 font-semibold text-sm">
      <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z"></path></svg>
      Tanya Harga & Jadwal
    </button>

    <!-- Chat Box -->
    <div id="chat-box" class="hidden w-96 sm:w-[380px] h-[540px] bg-milk border border-ink rounded-none shadow-2xl flex flex-col overflow-hidden mb-4 transition-all duration-300">
      <!-- Chat Header -->
      <div class="bg-stone border-b border-hairline px-6 py-4 flex items-center justify-between">
        <div class="flex items-center gap-3">
          <div class="w-2 h-2 rounded-full bg-ink animate-pulse"></div>
          <div>
            <h3 class="font-bold text-sm text-ink">Asisten Smart Gallery</h3>
            <p class="text-xs text-muted">Aktif 24 Jam</p>
          </div>
        </div>
        <button onclick="toggleChatbot()" class="text-muted hover:text-ink">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M6 18L18 6M6 6l12 12"></path></svg>
        </button>
      </div>

      <!-- Messages Area -->
      <div id="chat-messages" class="flex-1 p-4 overflow-y-auto space-y-4 text-sm">
        <div class="flex gap-3 justify-start">
          <div class="bg-ivory border-l-2 border-ink p-4 max-w-[80%] leading-relaxed rounded-none">
            Halo! Saya asisten AI Smart Gallery 🤖<br><br>Ada yang bisa saya bantu terkait harga paket wisuda, wedding, atau prewedding hari ini?
          </div>
        </div>
      </div>

      <!-- Quick Template Chips -->
      <div class="px-4 py-2 bg-stone border-t border-hairline flex gap-2 overflow-x-auto text-xs">
        <button onclick="sendQuickMessage('Daftar Harga Paket Wisuda')" class="bg-alabaster hover:bg-cement text-ink px-3 py-1.5 border border-hairline whitespace-nowrap transition-colors">Daftar Harga Paket Wisuda</button>
        <button onclick="sendQuickMessage('Estimasi Paket Wedding & Prewedding')" class="bg-alabaster hover:bg-cement text-ink px-3 py-1.5 border border-hairline whitespace-nowrap transition-colors">Estimasi Paket Wedding & Prewedding</button>
        <a href="https://wa.me/6281234567890?text=Halo%2C%20saya%20ingin%20konsultasi%20jasa%20fotografi" target="_blank" class="bg-ink hover:bg-charcoal text-milk px-3 py-1.5 border border-ink whitespace-nowrap transition-colors font-semibold">Hubungi Admin (WA)</a>
      </div>

      <!-- Input Area -->
      <form id="chat-form" onsubmit="handleChatSubmit(event)" class="p-3 bg-stone border-t border-hairline flex gap-2">
        <input type="text" id="chat-input" placeholder="Tulis pesan atau pertanyaan..." class="flex-1 bg-alabaster border border-hairline px-4 py-2.5 text-ink placeholder-numeral focus:outline-none focus:border-ink text-sm rounded-none">
        <button type="submit" class="bg-ink hover:bg-charcoal text-milk px-5 py-2.5 font-bold transition-all rounded-none">Kirim</button>
      </form>
    </div>
  </div>

  <script>
    // const sessionId = 'session_' + Math.random().toString(36.substring(2)); 

    function toggleChatbot() {
      const chatBox = document.getElementById('chat-box');
      chatBox.classList.toggle('hidden');
      if (!chatBox.classList.contains('hidden')) {
        document.getElementById('chat-input').focus();
      }
    }

    function sendQuickMessage(text) {
      document.getElementById('chat-input').value = text;
      handleChatSubmit(new Event('submit'));
    }

    async function handleChatSubmit(e) {
      e.preventDefault();
      const input = document.getElementById('chat-input');
      const message = input.value.trim();
      if (!message) return;

      const messagesContainer = document.getElementById('chat-messages');
      
      // Append user message
      messagesContainer.innerHTML += `
        <div class="flex gap-3 justify-end">
          <div class="bg-stone p-4 max-w-[80%] leading-relaxed font-medium rounded-none">
            ${escapeHtml(message)}
          </div>
        </div>
      `;
      input.value = '';
      messagesContainer.scrollTop = messagesContainer.scrollHeight;

      // Append typing indicator
      const typingId = 'typing_' + Date.now();
      messagesContainer.innerHTML += `
        <div id="${typingId}" class="flex gap-3 justify-start">
          <div class="bg-ivory border-l-2 border-ink p-4 max-w-[80%] leading-relaxed rounded-none text-muted animate-pulse">
            Menyusun informasi paket...
          </div>
        </div>
      `;
      messagesContainer.scrollTop = messagesContainer.scrollHeight;

      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ message })
        });
        const data = await res.json();
        
        document.getElementById(typingId).remove();

        if (data.success && data.data && data.data.reply) {
          messagesContainer.innerHTML += `
            <div class="flex gap-3 justify-start">
              <div class="bg-ivory border-l-2 border-ink p-4 max-w-[80%] leading-relaxed rounded-none whitespace-pre-line">
                ${escapeHtml(data.data.reply)}
              </div>
            </div>
          `;
        } else {
          messagesContainer.innerHTML += `
            <div class="flex gap-3 justify-start">
              <div class="bg-stone p-4 max-w-[80%] leading-relaxed rounded-none text-ink">
                Maaf, terjadi gangguan pada sistem AI. Silakan hubungi admin via WhatsApp.
              </div>
            </div>
          `;
        }
      } catch (err) {
        document.getElementById(typingId).remove();
        messagesContainer.innerHTML += `
          <div class="flex gap-3 justify-start">
            <div class="bg-stone p-4 max-w-[80%] leading-relaxed rounded-none text-ink">
              Gagal terhubung ke server. Silakan coba lagi atau hubungi admin.
            </div>
          </div>
        `;
      }
      messagesContainer.scrollTop = messagesContainer.scrollHeight;
    }

    function filterPackages(category) {
      document.querySelectorAll('.cat-btn').forEach(btn => {
        if (btn.dataset.category === category) {
          btn.className = 'cat-btn px-6 py-2.5 text-sm font-semibold transition-all border bg-ink text-milk border-ink';
        } else {
          btn.className = 'cat-btn px-6 py-2.5 text-sm font-semibold transition-all border bg-milk text-muted border-hairline hover:border-ink hover:text-ink';
        }
      });

      document.querySelectorAll('.package-card').forEach(card => {
        if (category === 'Semua' || card.dataset.category === category) {
          card.style.display = 'flex';
        } else {
          card.style.display = 'none';
        }
      });
    }

    // ini adalah fungsi untuk menghindari XSS, memastikan teks yang dimasukkan aman untuk ditampilkan di HTML
    function escapeHtml(text) {
      return text.replace(/&/g, "&").replace(/</g, "<").replace(/>/g, ">").replace(/"/g, "").replace(/'/g, "&#039;"); 
    }
  </script>

<%- include('partials/footer') %>