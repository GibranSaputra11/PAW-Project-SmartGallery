<%- include('../partials/head', { title: 'Tambah Paket - Smart Gallery' }) %>
<%- include('../partials/admin-sidebar') %>

<body class="bg-ivory text-ink min-h-screen">
  <main class="lg:pl-[240px] pt-0 lg:pt-0 min-h-screen">
    <!-- Mobile header handled by admin-sidebar partial -->

    <div class="p-6 lg:p-8 max-w-2xl mx-auto">
      <div class="mb-8">
        <h1 class="text-3xl font-display uppercase tracking-wide text-ink">Tambah Paket Pricelist</h1>
        <p class="text-muted text-sm mt-1">Buat paket layanan baru untuk website</p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-6 p-4 bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center gap-2">
          <svg class="w-5 h-5 shrink-0 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          <span><%= error %></span>
        </div>
      <% } %>

      <form method="POST" action="/admin/pricing/create" class="bg-milk p-8 border border-hairline space-y-6">
        <div>
          <label for="name" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-2">Nama Paket *</label>
          <input type="text" id="name" name="name" required maxlength="100" class="w-full px-4 py-3 bg-alabaster border border-hairline text-ink placeholder-numeral focus:outline-none focus:border-ink transition-all text-sm" placeholder="Contoh: Paket Wisuda Gold">
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="category" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-2">Kategori *</label>
            <select id="category" name="category" required class="w-full px-4 py-3 bg-alabaster border border-hairline text-ink focus:outline-none focus:border-ink transition-all text-sm appearance-none">
              <option value="">Pilih Kategori</option>
              <option value="Wisuda">Wisuda</option>
              <option value="Prewedding">Prewedding</option>
              <option value="Wedding">Wedding</option>
            </select>
          </div>

          <div>
            <label for="price" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-2">Harga (IDR) *</label>
            <input type="number" id="price" name="price" required min="0" step="1000" class="w-full px-4 py-3 bg-alabaster border border-hairline text-ink placeholder-numeral focus:outline-none focus:border-ink transition-all text-sm font-mono" placeholder="500000">
          </div>
        </div>

        <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
          <div>
            <label for="duration" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-2">Durasi *</label>
            <input type="text" id="duration" name="duration" required maxlength="50" class="w-full px-4 py-3 bg-alabaster border border-hairline text-ink placeholder-numeral focus:outline-none focus:border-ink transition-all text-sm" placeholder="Contoh: 2 Jam Sesi Foto">
          </div>

          <div class="flex items-center pt-6">
            <label class="flex items-center gap-3 cursor-pointer">
              <input type="checkbox" name="popular" value="true" class="w-5 h-5 rounded-none bg-alabaster border border-hairline text-ink focus:ring-0">
              <span class="text-xs font-semibold text-ink uppercase tracking-wider">Tandai sebagai Paling Populer</span>
            </label>
          </div>
        </div>

        <div>
          <label for="description" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-2">Deskripsi Paket *</label>
          <textarea id="description" name="description" required rows="3" class="w-full px-4 py-3 bg-alabaster border border-hairline text-ink placeholder-numeral focus:outline-none focus:border-ink transition-all text-sm" placeholder="Deskripsi singkat layanan paket..."></textarea>
        </div>

        <div>
          <label for="features" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-2">Fasilitas Termasuk (Satu per baris) *</label>
          <textarea id="features" name="features" required rows="4" class="w-full px-4 py-3 bg-alabaster border border-hairline text-ink placeholder-numeral focus:outline-none focus:border-ink transition-all text-sm font-mono" placeholder="1 fotografer profesional&#10;15 foto edit HD&#10;Softcopy via Google Drive"></textarea>
          <p class="text-xs text-muted mt-1">Pisahkan setiap fasilitas dengan baris baru (Enter).</p>
        </div>

        <div>
          <label for="notIncluded" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-2">Tidak Termasuk (Opsional, Satu per baris)</label>
          <textarea id="notIncluded" name="notIncluded" rows="3" class="w-full px-4 py-3 bg-alabaster border border-hairline text-ink placeholder-numeral focus:outline-none focus:border-ink transition-all text-sm font-mono" placeholder="Biaya sewa studio/lokasi&#10;Makeup artist"></textarea>
        </div>

        <div class="flex gap-4 pt-4 border-t border-hairline">
          <button type="submit" class="flex-1 bg-ink hover:bg-charcoal text-milk font-semibold py-3.5 px-6 transition-all text-sm border border-ink">
            Simpan Paket
          </button>
          <a href="/admin/pricing" class="flex-1 bg-milk hover:bg-stone text-ink font-semibold py-3.5 px-6 text-center border border-hairline transition-colors">
            Batal
          </a>
        </div>
      </form>
    </div>
  </main>
</body>
</html>