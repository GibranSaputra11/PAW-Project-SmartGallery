<%- include('../partials/head', { title: 'Kelola FAQ - Smart Gallery' }) %>
<%- include('../partials/admin-sidebar') %>

<body class="bg-ivory text-ink min-h-screen">
  <main class="lg:pl-[240px] pt-0 lg:pt-0 min-h-screen">
    <!-- Mobile header handled by admin-sidebar partial -->

    <div class="p-6 lg:p-8 max-w-7xl mx-auto">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
        <div>
          <h1 class="text-3xl font-display uppercase tracking-wide text-ink">Kelola FAQ</h1>
          <p class="text-muted text-sm mt-1">Pertanyaan yang sering diajukan untuk AI Chatbot</p>
        </div>
        <a href="/admin/faqs/create" class="bg-ink hover:bg-ink/90 text-ivory font-bold px-6 py-3 transition-all flex items-center justify-center gap-2 shadow-sm">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
          <span>Tambah FAQ Baru</span>
        </a>
      </div>

      <% if (typeof message !== 'undefined' && message) { %>
        <div class="mb-6 p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center gap-2">
          <svg class="w-5 h-5 shrink-0 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          <span><%= message %></span>
        </div>
      <% } %>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-6 p-4 bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center gap-2">
          <svg class="w-5 h-5 shrink-0 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          <span><%= error %></span>
        </div>
      <% } %>

      <div class="bg-milk border border-hairline overflow-hidden">
        <% if (faqs.length === 0) { %>
          <div class="text-center py-20 px-4">
            <svg class="w-16 h-16 mx-auto text-muted/30 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <h3 class="text-xl font-semibold text-ink mb-2">Belum Ada FAQ</h3>
            <p class="text-muted mb-6 text-sm">Tambahkan pertanyaan yang sering diajukan untuk AI Chatbot.</p>
            <a href="/admin/faqs/create" class="bg-ink hover:bg-ink/90 text-ivory font-bold px-6 py-3 transition-all inline-flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
              <span>Tambah FAQ Pertama</span>
            </a>
          </div>
        <% } else { %>
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead class="bg-stone border-b border-hairline">
                <tr>
                  <th class="px-6 py-4 text-xs font-bold text-muted uppercase tracking-wider">Pertanyaan</th>
                  <th class="px-6 py-4 text-xs font-bold text-muted uppercase tracking-wider">Jawaban</th>
                  <th class="px-6 py-4 text-xs font-bold text-muted uppercase tracking-wider">Kategori</th>
                  <th class="px-6 py-4 text-xs font-bold text-muted uppercase tracking-wider">Tanggal</th>
                  <th class="px-6 py-4 text-xs font-bold text-muted uppercase tracking-wider">Aksi</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-hairline">
                <% faqs.forEach(function(faq) { %>
                  <tr class="hover:bg-stone/50 transition-colors">
                    <td class="px-6 py-4">
                      <p class="font-medium text-ink max-w-xs truncate" title="<%= faq.question %>"><%= faq.question %></p>
                    </td>
                    <td class="px-6 py-4">
                      <p class="text-sm text-muted max-w-md truncate" title="<%= faq.answer %>"><%= faq.answer %></p>
                    </td>
                    <td class="px-6 py-4">
                      <span class="text-xs font-semibold px-2.5 py-1 bg-stone text-ink border border-hairline"><%= faq.category || 'Umum' %></span>
                    </td>
                    <td class="px-6 py-4 text-sm text-muted font-mono">
                      <%= new Date(faq.createdAt).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) %>
                    </td>
                    <td class="px-6 py-4">
                      <div class="flex items-center gap-3">
                        <a href="/admin/faqs/<%= faq.id %>/edit" class="text-ink hover:text-muted text-sm font-medium flex items-center gap-1 transition-colors">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 5H6a2 2 0 00-2 2v11a2 2 0 002 2h11a2 2 0 002-2v-5m-1.414-9.414a2 2 0 112.828 2.828L11.828 15H9v-2.828l8.586-8.586z"></path></svg>
                          <span>Edit</span>
                        </a>
                        <form action="/admin/faqs/<%= faq.id %>/delete" method="POST" class="inline" onsubmit="return confirm('Yakin hapus FAQ ini?')">
                          <button type="submit" class="text-rose-600 hover:text-rose-800 text-sm font-medium flex items-center gap-1 transition-colors">
                            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v12m-6 0h12a2 2 0 002-2V7a2 2 0 00-2-2H7"></path></svg>
                            <span>Hapus</span>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </main>
</body>
</html>