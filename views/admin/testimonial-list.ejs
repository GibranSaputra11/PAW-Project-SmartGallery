<%- include('../partials/head', { title: 'Kelola Testimoni - Smart Gallery' }) %>
<%- include('../partials/admin-sidebar') %>

<body class="bg-ivory text-ink min-h-screen">
  <main class="lg:pl-[240px] pt-0 lg:pt-0 min-h-screen">
    <!-- Mobile header handled by admin-sidebar partial -->

    <div class="p-6 lg:p-8 max-w-7xl mx-auto">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
        <div>
          <h1 class="text-3xl font-display uppercase tracking-wide text-ink">Kelola Testimoni</h1>
          <p class="text-muted text-sm mt-1">Kelola review & testimoni klien</p>
        </div>
        <a href="/admin/testimonials/create" class="bg-ink hover:bg-ink/90 text-ivory font-bold px-6 py-3 transition-all flex items-center justify-center gap-2 shadow-sm">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
          <span>Tambah Testimoni</span>
        </a>
      </div>

      <% if (typeof message !== 'undefined' && message) { %>
        <div class="mb-6 p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center gap-2">
          <svg class="w-5 h-5 shrink-0 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          <span><%= message %></span>
        </div>
      <% } %>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-6 p-4 bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center gap-2">
          <svg class="w-5 h-5 shrink-0 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          <span><%= error %></span>
        </div>
      <% } %>

      <div class="bg-milk border border-hairline overflow-hidden">
        <% if (testimonials.length === 0) { %>
          <div class="text-center py-20 px-4">
            <svg class="w-16 h-16 mx-auto text-muted/30 mb-4" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.690h3.462c.969 0 1.371 1.24.588 1.810l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.690l1.07-3.292z"/></svg>
            <h3 class="text-xl font-semibold text-ink mb-2">Belum Ada Testimoni</h3>
            <p class="text-muted mb-6 text-sm">Mulai tambahkan testimoni klien pertama Anda.</p>
            <a href="/admin/testimonials/create" class="bg-ink hover:bg-ink/90 text-ivory font-bold px-6 py-3 transition-all inline-flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
              <span>Tambah Testimoni Pertama</span>
            </a>
          </div>
        <% } else { %>
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead class="bg-stone border-b border-hairline">
                <tr>
                  <th class="px-6 py-4 text-xs font-bold text-muted uppercase tracking-wider">Nama Klien</th>
                  <th class="px-6 py-4 text-xs font-bold text-muted uppercase tracking-wider">Rating</th>
                  <th class="px-6 py-4 text-xs font-bold text-muted uppercase tracking-wider">Pesan</th>
                  <th class="px-6 py-4 text-xs font-bold text-muted uppercase tracking-wider">Aksi</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-hairline">
                <% testimonials.forEach(function(t) { %>
                  <tr class="hover:bg-stone/50 transition-colors">
                    <td class="px-6 py-4 font-medium text-ink"><%= t.clientName %></td>
                    <td class="px-6 py-4">
                      <div class="flex items-center gap-1 text-amber-500">
                        <% for(let i=0; i < t.rating; i++) { %>
                          <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.690h3.462c.969 0 1.371 1.24.588 1.810l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.690l1.07-3.292z"/></svg>
                        <% } %>
                      </div>
                    </td>
                    <td class="px-6 py-4 text-muted line-clamp-2 max-w-xs">"<%= t.message %>"</td>
                    <td class="px-6 py-4">
                      <form action="/admin/testimonials/<%= t.id %>/delete" method="POST" class="inline" onsubmit="return confirm('Yakin hapus testimoni ini?')">
                        <button type="submit" class="text-rose-600 hover:text-rose-800 text-sm font-medium font-mono flex items-center gap-1 transition-colors">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v12m-6 0h12a2 2 0 002-2V7a2 2 0 00-2-2H7"></path></svg>
                          <span>Hapus</span>
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </main>
</body>
</html>