<%- include('../partials/head', { title: 'Login Admin - Smart Gallery' }) %>

<body class="bg-street text-paper min-h-screen flex items-center justify-center selection:bg-accent selection:text-street p-4">

  <div class="w-full max-w-md">
    <div class="bg-cardbg rounded-3xl p-10 border border-slate-800 relative overflow-hidden">
      <!-- Torn paper top edge effect -->
      <div class="absolute top-0 left-0 right-0 h-2 bg-gradient-to-b from-street to-transparent pointer-events-none"></div>
      
      <!-- Decorative accent lines -->
      <div class="absolute top-4 right-4 w-16 h-16 border-2 border-accent/20 rounded-full rotate-12"></div>
      <div class="absolute bottom-4 left-4 w-12 h-12 border-2 border-accent/10 rounded-full -rotate-6"></div>

      <div class="relative z-10 text-center mb-8">
        <a href="/" class="inline-flex items-center gap-2 group mb-6">
          <svg class="w-12 h-12 text-accent group-hover:scale-105 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path>
          </svg>
          <span class="font-display text-3xl tracking-wider text-paper">SMART</span>
        </a>
        <span class="font-script text-accent text-2xl -ml-8 -mt-4 block">Gallery</span>
        
        <p class="text-muted text-sm mt-2">Admin Panel</p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-6 p-4 bg-red-500/10 border border-red-500/30 rounded-xl text-red-400 text-sm flex items-center gap-2 animate-shake">
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          <span><%= error %></span>
        </div>
      <% } %>

      <form method="POST" action="/auth/login" class="space-y-5">
        <div>
          <label for="username" class="block text-sm font-medium text-paper mb-2 text-left">Username</label>
          <div class="relative">
            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path></svg>
            <input 
              type="text" 
              id="username" 
              name="username" 
              required 
              autocomplete="username"
              class="w-full pl-12 pr-4 py-3.5 bg-street border border-slate-800 rounded-xl text-paper placeholder-muted focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all" 
              placeholder="Masukkan username"
            >
          </div>
        </div>

        <div>
          <label for="password" class="block text-sm font-medium text-paper mb-2 text-left">Password</label>
          <div class="relative">
            <svg class="absolute left-4 top-1/2 -translate-y-1/2 w-5 h-5 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
            <input 
              type="password" 
              id="password" 
              name="password" 
              required 
              autocomplete="current-password"
              class="w-full pl-12 pr-4 py-3.5 bg-street border border-slate-800 rounded-xl text-paper placeholder-muted focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all" 
              placeholder="Masukkan password"
            >
          </div>
        </div>

        <button 
          type="submit" 
          class="w-full bg-accent hover:bg-accent/90 text-street font-bold py-3.5 px-6 rounded-xl transition-all shadow-sm shadow-accent/20 flex items-center justify-center gap-2"
        >
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M11 16l-4-4m0 0l4-4m-4 4h14m-5 4v1a3 3 0 01-3 3H6a3 3 0 01-3-3V7a3 3 0 013-3h7a3 3 0 013 3v1"></path></svg>
          Masuk ke Dashboard
        </button>
      </form>

      <div class="mt-8 pt-6 border-t border-slate-800">
        <p class="text-xs text-muted text-center">
          <svg class="w-4 h-4 inline mx-1" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z"></path></svg>
          Hanya untuk pemilik jasa Smart Gallery
        </p>
      </div>
    </div>

    <!-- Back link -->
    <div class="text-center mt-6">
      <a href="/" class="text-muted hover:text-paper text-sm transition-colors flex items-center justify-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        Kembali ke Website
      </a>
    </div>
  </div>

  <style>
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      10%, 30%, 50%, 70%, 90% { transform: translateX(-4px); }
      20%, 40%, 60%, 80% { transform: translateX(4px); }
    }
    .animate-shake { animation: shake 0.5s ease-in-out; }
  </style>

<%- include('../partials/footer') %>