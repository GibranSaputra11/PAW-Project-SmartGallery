<%- include('../partials/head', { title: 'Tambah Galeri - Smart Gallery' }) %>
<%- include('../partials/admin-sidebar') %>

<body class="bg-ivory text-ink min-h-screen">
  <main class="lg:pl-[240px] pt-0 lg:pt-0 min-h-screen">
    <!-- Mobile header handled by admin-sidebar partial -->

    <div class="p-6 lg:p-8 max-w-2xl mx-auto">
      <div class="mb-8">
        <h1 class="text-3xl font-display uppercase tracking-wide text-ink">Tambah Galeri Baru</h1>
        <p class="text-muted text-sm mt-1">Upload foto atau video portofolio</p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-6 p-4 bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center gap-2">
          <svg class="w-5 h-5 shrink-0 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          <span><%= error %></span>
        </div>
      <% } %>

      <form method="POST" action="/admin/gallery/create" enctype="multipart/form-data" class="bg-milk p-8 border border-hairline space-y-6">
        <div>
          <label for="title" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-2">Judul *</label>
          <input type="text" id="title" name="title" required maxlength="100" class="w-full px-4 py-3 bg-alabaster border border-hairline text-ink placeholder-numeral focus:outline-none focus:border-ink transition-all text-sm" placeholder="Contoh: Wisuda Mahasiswa TI UMY 2024">
        </div>

        <div>
          <label for="category" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-2">Kategori *</label>
          <select id="category" name="category" required class="w-full px-4 py-3 bg-alabaster border border-hairline text-ink focus:outline-none focus:border-ink transition-all text-sm appearance-none">
            <option value="">Pilih Kategori</option>
            <option value="Wisuda">Wisuda</option>
            <option value="Prewedding">Prewedding</option>
            <option value="Wedding">Wedding</option>
            <option value="Lainnya">Lainnya</option>
          </select>
        </div>

        <div>
          <label for="type" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-2">Tipe Media *</label>
          <select id="type" name="type" required class="w-full px-4 py-3 bg-alabaster border border-hairline text-ink focus:outline-none focus:border-ink transition-all text-sm appearance-none">
            <option value="photo">Foto</option>
            <option value="video">Video</option>
          </select>
        </div>

        <div>
          <label for="image" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-2">File Media * (Max 2MB, JPG/PNG/WebP/MP4)</label>
          <input type="file" id="image" name="image" required accept="image/jpeg,image/png,image/webp,video/mp4" class="w-full px-4 py-3 bg-alabaster border border-hairline text-ink file:mr-4 file:py-2 file:px-4 file:border-0 file:bg-stone file:text-ink hover:file:bg-hairline focus:outline-none focus:border-ink transition-all text-sm">
          <p class="text-xs text-muted mt-1">Format didukung: JPG, PNG, WebP, MP4. Maksimal 2MB.</p>
        </div>

        <div>
          <label for="eventDate" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-2">Tanggal Acara (Opsional)</label>
          <input type="date" id="eventDate" name="eventDate" class="w-full px-4 py-3 bg-alabaster border border-hairline text-ink focus:outline-none focus:border-ink transition-all text-sm">
        </div>

        <div>
          <label for="videoUrl" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-2">URL Video YouTube/Vimeo (Opsional, hanya untuk tipe Video)</label>
          <input type="url" id="videoUrl" name="videoUrl" class="w-full px-4 py-3 bg-alabaster border border-hairline text-ink placeholder-numeral focus:outline-none focus:border-ink transition-all text-sm" placeholder="https://youtube.com/watch?v=...">
        </div>

        <div class="flex gap-4 pt-4 border-t border-hairline">
          <button type="submit" class="flex-1 bg-ink hover:bg-charcoal text-milk font-semibold py-3.5 px-6 transition-all text-sm border border-ink">
            Simpan Galeri
          </button>
          <a href="/admin/gallery" class="flex-1 bg-milk hover:bg-stone text-ink font-semibold py-3.5 px-6 text-center border border-hairline transition-colors">
            Batal
          </a>
        </div>
      </form>
    </div>
  </main>
</body>
</html>