<%- include('../partials/head', { title: 'Tambah Galeri - Smart Gallery' }) %>

<body class="bg-street text-paper min-h-screen flex flex-col selection:bg-accent selection:text-street">

  <header class="sticky top-0 z-40 bg-street/90 backdrop-blur-md border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
      <a href="/admin/gallery" class="flex items-center gap-2 group">
        <svg class="w-8 h-8 text-accent group-hover:scale-105 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        <span class="font-display text-2xl tracking-wider text-paper">SMART</span>
      </a>
      <span class="font-script text-accent text-xl -ml-6 -mt-2">Gallery</span>

      <div class="flex items-center gap-4">
        <span class="text-sm text-muted">Admin: <strong class="text-paper"><%= session.username %></strong></span>
        <a href="/admin/gallery" class="text-muted hover:text-paper transition-colors text-sm">Kembali</a>
        <form action="/auth/logout" method="POST" class="inline">
          <button type="submit" class="text-red-400 hover:text-red-300 text-sm font-medium">Logout</button>
        </form>
      </div>
    </div>
  </header>

  <main class="flex-1 max-w-2xl w-full mx-auto px-6 py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-display uppercase tracking-wide text-paper">Tambah Galeri Baru</h1>
      <p class="text-muted text-sm mt-1">Upload foto atau video portofolio</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mb-6 p-4 bg-red-500/10 border border-red-500/30 rounded-xl text-red-400 text-sm flex items-center gap-2">
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        <span><%= error %></span>
      </div>
    <% } %>

    <form method="POST" action="/admin/gallery/create" enctype="multipart/form-data" class="bg-cardbg rounded-2xl p-8 border border-slate-800 space-y-6">
      <div>
        <label for="title" class="block text-sm font-medium text-paper mb-2">Judul *</label>
        <input type="text" id="title" name="title" required maxlength="100" class="w-full bg-street border border-slate-800 rounded-xl px-4 py-3 text-paper placeholder-muted focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all" placeholder="Contoh: Wisuda Mahasiswa TI UMY 2024">
      </div>

      <div>
        <label for="category" class="block text-sm font-medium text-paper mb-2">Kategori *</label>
        <select id="category" name="category" required class="w-full bg-street border border-slate-800 rounded-xl px-4 py-3 text-paper focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all appearance-none">
          <option value="">Pilih Kategori</option>
          <option value="Wisuda">🎓 Wisuda</option>
          <option value="Prewedding">💑 Prewedding</option>
          <option value="Wedding">💍 Wedding</option>
          <option value="Lainnya">📷 Lainnya</option>
        </select>
      </div>

      <div>
        <label for="type" class="block text-sm font-medium text-paper mb-2">Tipe Media *</label>
        <select id="type" name="type" required class="w-full bg-street border border-slate-800 rounded-xl px-4 py-3 text-paper focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all appearance-none">
          <option value="photo">📸 Foto</option>
          <option value="video">🎬 Video</option>
        </select>
      </div>

      <div>
        <label for="image" class="block text-sm font-medium text-paper mb-2">File Media * (Max 2MB, JPG/PNG/WebP/MP4)</label>
        <input type="file" id="image" name="image" required accept="image/jpeg,image/png,image/webp,video/mp4" class="w-full bg-street border border-slate-800 rounded-xl px-4 py-3 text-paper file:mr-4 file:py-2 file:px-4 file:rounded-lg file:border-0 file:bg-accent/10 file:text-accent hover:file:bg-accent/20 focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all">
        <p class="text-xs text-muted mt-1">Format didukung: JPG, PNG, WebP, MP4. Maksimal 2MB.</p>
      </div>

      <div>
        <label for="eventDate" class="block text-sm font-medium text-paper mb-2">Tanggal Acara (Opsional)</label>
        <input type="date" id="eventDate" name="eventDate" class="w-full bg-street border border-slate-800 rounded-xl px-4 py-3 text-paper focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all">
      </div>

      <div>
        <label for="videoUrl" class="block text-sm font-medium text-paper mb-2">URL Video YouTube/Vimeo (Opsional, hanya untuk tipe Video)</label>
        <input type="url" id="videoUrl" name="videoUrl" class="w-full bg-street border border-slate-800 rounded-xl px-4 py-3 text-paper placeholder-muted focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all" placeholder="https://youtube.com/watch?v=...">
      </div>

      <div class="flex gap-4 pt-4 border-t border-slate-800">
        <button type="submit" class="flex-1 bg-accent hover:bg-accent/90 text-street font-bold py-3 px-6 rounded-xl transition-all shadow-sm">
          Simpan Galeri
        </button>
        <a href="/admin/gallery" class="flex-1 bg-street hover:bg-slate-800 text-paper font-semibold py-3 px-6 rounded-xl text-center border border-slate-800 transition-colors">
          Batal
        </a>
      </div>
    </form>
  </main>

<%- include('../partials/footer') %>