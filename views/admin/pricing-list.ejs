<%- include('../partials/head', { title: 'Kelola Pricelist - Smart Gallery' }) %>
<%- include('../partials/admin-sidebar') %>

<body class="bg-ivory text-ink min-h-screen">
  <main class="lg:pl-[240px] pt-0 lg:pt-0 min-h-screen">
    <!-- Mobile header handled by admin-sidebar partial -->

    <div class="p-6 lg:p-8 max-w-7xl mx-auto">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
        <div>
          <h1 class="text-3xl font-display uppercase tracking-wide text-ink">Kelola Pricelist</h1>
          <p class="text-muted text-sm mt-1">Kelola paket layanan fotografi & videografi</p>
        </div>
        <a href="/admin/pricing/create" class="bg-ink hover:bg-ink/90 text-ivory font-bold px-6 py-3 transition-all flex items-center justify-center gap-2 shadow-sm">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
          <span>Tambah Paket Baru</span>
        </a>
      </div>

      <% if (typeof message !== 'undefined' && message) { %>
        <div class="mb-6 p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center gap-2">
          <svg class="w-5 h-5 shrink-0 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          <span><%= message %></span>
        </div>
      <% } %>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-6 p-4 bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center gap-2">
          <svg class="w-5 h-5 shrink-0 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          <span><%= error %></span>
        </div>
      <% } %>

      <div class="bg-milk border border-hairline overflow-hidden">
        <% if (packages.length === 0) { %>
          <div class="text-center py-20 px-4">
            <svg class="w-16 h-16 mx-auto text-muted/30 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
            <h3 class="text-xl font-semibold text-ink mb-2">Belum Ada Paket</h3>
            <p class="text-muted mb-6 text-sm">Mulai tambahkan paket layanan pertama Anda.</p>
            <a href="/admin/pricing/create" class="bg-ink hover:bg-ink/90 text-ivory font-bold px-6 py-3 transition-all inline-flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
              <span>Tambah Paket Pertama</span>
            </a>
          </div>
        <% } else { %>
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead class="bg-stone border-b border-hairline">
                <tr>
                  <th class="px-6 py-4 text-xs font-bold text-muted uppercase tracking-wider">Nama Paket</th>
                  <th class="px-6 py-4 text-xs font-bold text-muted uppercase tracking-wider">Kategori</th>
                  <th class="px-6 py-4 text-xs font-bold text-muted uppercase tracking-wider">Harga</th>
                  <th class="px-6 py-4 text-xs font-bold text-muted uppercase tracking-wider">Durasi</th>
                  <th class="px-6 py-4 text-xs font-bold text-muted uppercase tracking-wider">Status</th>
                  <th class="px-6 py-4 text-xs font-bold text-muted uppercase tracking-wider">Aksi</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-hairline">
                <% packages.forEach(function(pkg) { %>
                  <tr class="hover:bg-stone/50 transition-colors">
                    <td class="px-6 py-4">
                      <p class="font-medium text-ink"><%= pkg.name %></p>
                      <p class="text-xs text-muted line-clamp-1"><%= pkg.description %></p>
                    </td>
                    <td class="px-6 py-4">
                      <span class="text-xs font-semibold px-2.5 py-1 bg-stone border border-hairline text-ink"><%= pkg.category %></span>
                    </td>
                    <td class="px-6 py-4 font-semibold text-ink font-mono">Rp <%= pkg.price.toLocaleString('id-ID') %></td>
                    <td class="px-6 py-4 text-sm text-muted"><%= pkg.duration %></td>
                    <td class="px-6 py-4">
                      <% if (pkg.popular) { %>
                        <span class="inline-flex items-center gap-1 text-xs font-bold px-2.5 py-1 bg-stone border border-hairline text-ink">
                          <span class="w-1.5 h-1.5 rounded-full bg-ink animate-pulse"></span>
                          Populer
                        </span>
                      <% } else { %>
                        <span class="text-xs text-muted">Reguler</span>
                      <% } %>
                    </td>
                    <td class="px-6 py-4">
                      <div class="flex items-center gap-2">
                        <a href="/admin/pricing/<%= pkg.id %>/edit" class="text-ink hover:text-ink/70 text-sm font-medium font-mono">Edit</a>
                        <form action="/admin/pricing/<%= pkg.id %>/delete" method="POST" class="inline" onsubmit="return confirm('Yakin hapus paket ini?')">
                          <button type="submit" class="text-rose-600 hover:text-rose-800 text-sm font-medium font-mono transition-colors">Hapus</button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </main>
</body>
</html>