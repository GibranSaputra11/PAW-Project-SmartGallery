<%- include('../partials/head', { title: 'Edit Galeri - Smart Gallery' }) %>
<%- include('../partials/admin-sidebar') %>

<body class="bg-ivory text-ink min-h-screen">
  <main class="lg:pl-[240px] pt-0 lg:pt-0 min-h-screen">
    <!-- Mobile header handled by admin-sidebar partial -->

    <div class="p-6 lg:p-8 max-w-2xl mx-auto">
      <div class="mb-8">
        <h1 class="text-3xl font-display uppercase tracking-wide text-ink">Edit Galeri</h1>
        <p class="text-muted text-sm mt-1">Perbarui detail galeri</p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-6 p-4 bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center gap-2">
          <svg class="w-5 h-5 shrink-0 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          <span><%= error %></span>
        </div>
      <% } %>

      <form method="POST" action="/admin/gallery/<%= gallery.id %>/update" class="bg-milk p-8 border border-hairline space-y-6">
        <div>
          <label for="title" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-2">Judul *</label>
          <input type="text" id="title" name="title" required maxlength="100" value="<%= gallery.title %>" class="w-full px-4 py-3 bg-alabaster border border-hairline text-ink placeholder-numeral focus:outline-none focus:border-ink transition-all text-sm" placeholder="Contoh: Wisuda Mahasiswa TI UMY 2024">
        </div>

        <div>
          <label for="category" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-2">Kategori *</label>
          <select id="category" name="category" required class="w-full px-4 py-3 bg-alabaster border border-hairline text-ink focus:outline-none focus:border-ink transition-all text-sm appearance-none">
            <option value="Wisuda" <%= gallery.category === 'Wisuda' ? 'selected' : '' %>>Wisuda</option>
            <option value="Prewedding" <%= gallery.category === 'Prewedding' ? 'selected' : '' %>>Prewedding</option>
            <option value="Wedding" <%= gallery.category === 'Wedding' ? 'selected' : '' %>>Wedding</option>
            <option value="Lainnya" <%= gallery.category === 'Lainnya' ? 'selected' : '' %>>Lainnya</option>
            <option value="Video" <%= gallery.category === 'Video' ? 'selected' : '' %>>Video</option>
          </select>
        </div>

        <div>
          <label for="videoUrl" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-2">URL Video YouTube/Vimeo (Opsional)</label>
          <input type="url" id="videoUrl" name="videoUrl" value="<%= gallery.videoUrl || '' %>" class="w-full px-4 py-3 bg-alabaster border border-hairline text-ink placeholder-numeral focus:outline-none focus:border-ink transition-all text-sm" placeholder="https://youtube.com/watch?v=...">
        </div>

        <div>
          <label for="eventDate" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-2">Tanggal Acara (Opsional)</label>
          <input type="date" id="eventDate" name="eventDate" value="<%= gallery.eventDate ? gallery.eventDate.toISOString().split('T')[0] : '' %>" class="w-full px-4 py-3 bg-alabaster border border-hairline text-ink focus:outline-none focus:border-ink transition-all text-sm">
        </div>

        <div class="bg-stone/30 border border-hairline p-4">
          <p class="text-xs text-muted flex items-center gap-2">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <strong>Catatan:</strong> Foto tidak bisa diubah di halaman ini. Hapus dan buat baru jika perlu mengganti foto.
          </p>
        </div>

        <div class="flex gap-4 pt-4 border-t border-hairline">
          <button type="submit" class="flex-1 bg-ink hover:bg-charcoal text-milk font-semibold py-3.5 px-6 transition-all text-sm border border-ink">
            Simpan Perubahan
          </button>
          <a href="/admin/gallery" class="flex-1 bg-milk hover:bg-stone text-ink font-semibold py-3.5 px-6 text-center border border-hairline transition-colors">
            Batal
          </a>
        </div>
      </form>
    </div>
  </main>
</body>
</html>