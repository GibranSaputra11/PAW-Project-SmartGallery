<%- include('../partials/head', { title: 'Tambah FAQ - Smart Gallery' }) %>
<%- include('../partials/admin-sidebar') %>

<body class="bg-ivory text-ink min-h-screen">
  <main class="lg:pl-[240px] pt-0 lg:pt-0 min-h-screen">
    <!-- Mobile header handled by admin-sidebar partial -->

    <div class="p-6 lg:p-8 max-w-2xl mx-auto">
      <div class="mb-8">
        <h1 class="text-3xl font-display uppercase tracking-wide text-ink">Tambah FAQ Baru</h1>
        <p class="text-muted text-sm mt-1">Data ini akan digunakan AI Chatbot untuk menjawab pertanyaan klien</p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-6 p-4 bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center gap-2">
          <svg class="w-5 h-5 shrink-0 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          <span><%= error %></span>
        </div>
      <% } %>

      <form method="POST" action="/admin/faqs/create" class="bg-milk p-8 border border-hairline space-y-6">
        <div>
          <label for="question" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-2">Pertanyaan *</label>
          <textarea id="question" name="question" required rows="3" maxlength="500" class="w-full px-4 py-3 bg-alabaster border border-hairline text-ink placeholder-numeral focus:outline-none focus:border-ink transition-all resize-none text-sm" placeholder="Contoh: Berapa harga paket wisuda?"></textarea>
          <p class="text-xs text-muted mt-1">Gunakan kata kunci yang kemungkinan diketik klien (mis: harga, paket, durasi, dll)</p>
        </div>

        <div>
          <label for="answer" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-2">Jawaban *</label>
          <textarea id="answer" name="answer" required rows="5" maxlength="2000" class="w-full px-4 py-3 bg-alabaster border border-hairline text-ink placeholder-numeral focus:outline-none focus:border-ink transition-all resize-none text-sm" placeholder="Jawaban lengkap yang akan diberikan chatbot ke klien..."></textarea>
          <p class="text-xs text-muted mt-1">Jawaban akan ditampilkan apa adanya oleh chatbot. Format dengan rapi.</p>
        </div>

        <div>
          <label for="category" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-2">Kategori</label>
          <select id="category" name="category" class="w-full px-4 py-3 bg-alabaster border border-hairline text-ink focus:outline-none focus:border-ink transition-all appearance-none text-sm">
            <option value="Umum">Umum</option>
            <option value="Harga">Harga & Paket</option>
            <option value="Layanan">Layanan & Produk</option>
            <option value="Proses">Proses & Alur</option>
            <option value="Teknis">Teknis & Lainnya</option>
          </select>
          <p class="text-xs text-muted mt-1">Kategori membantu mengorganisir FAQ di dashboard.</p>
        </div>

        <div class="bg-stone/30 border border-hairline p-4">
          <p class="text-xs text-muted flex items-center gap-2">
            <svg class="w-4 h-4 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            <strong>AI Data Source:</strong> Data FAQ ini dibaca langsung oleh AI Chatbot. Pastikan jawaban akurat dan up-to-date.
          </p>
        </div>

        <div class="flex gap-4 pt-4 border-t border-hairline">
          <button type="submit" class="flex-1 bg-ink hover:bg-charcoal text-milk font-semibold py-3.5 px-6 transition-all text-sm border border-ink">
            Simpan FAQ
          </button>
          <a href="/admin/faqs" class="flex-1 bg-milk hover:bg-stone text-ink font-semibold py-3.5 px-6 text-center border border-hairline transition-colors">
            Batal
          </a>
        </div>
      </form>
    </div>
  </main>
</body>
</html>