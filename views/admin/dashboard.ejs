<%- include('../partials/head', { title: 'Dashboard Admin - Smart Gallery' }) %>
<%- include('../partials/admin-sidebar') %>

<body class="bg-ivory text-ink min-h-screen">
  <main class="lg:pl-[240px] pt-0 lg:pt-0 min-h-screen">
    <!-- Mobile header handled by admin-sidebar partial -->

    <div class="p-6 lg:p-8 max-w-7xl mx-auto">
      <div class="mb-8">
        <h1 class="text-3xl font-display uppercase tracking-wide text-ink">Dashboard Admin</h1>
        <p class="text-muted text-sm mt-1">Kelola seluruh konten Smart Gallery dari sini</p>
      </div>

      <!-- Stats Cards -->
      <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-6 mb-10">
        <div class="bg-milk p-6 border border-hairline">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-xs font-bold text-muted uppercase tracking-wider">Total Paket</p>
              <p class="text-3xl font-black text-ink mt-1 font-mono"><%= stats.packages %></p>
            </div>
            <div class="w-12 h-12 border border-hairline flex items-center justify-center bg-stone">
              <svg class="w-6 h-6 text-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M20 7l-8-4-8 4m16 0l-8 4m8-4v10l-8 4m0-10L4 7m8 4v10M4 7v10l8 4"></path></svg>
            </div>
          </div>
        </div>

        <div class="bg-milk p-6 border border-hairline">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-xs font-bold text-muted uppercase tracking-wider">Total Galeri</p>
              <p class="text-3xl font-black text-ink mt-1 font-mono"><%= stats.galleries %></p>
            </div>
            <div class="w-12 h-12 border border-hairline flex items-center justify-center bg-stone">
              <svg class="w-6 h-6 text-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            </div>
          </div>
        </div>

        <div class="bg-milk p-6 border border-hairline">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-xs font-bold text-muted uppercase tracking-wider">Total Testimoni</p>
              <p class="text-3xl font-black text-ink mt-1 font-mono"><%= stats.testimonials %></p>
            </div>
            <div class="w-12 h-12 border border-hairline flex items-center justify-center bg-stone">
              <svg class="w-6 h-6 text-ink" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.690h3.462c.969 0 1.371 1.24.588 1.810l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.690l1.07-3.292z"/></svg>
            </div>
          </div>
        </div>

        <div class="bg-milk p-6 border border-hairline">
          <div class="flex items-center justify-between">
            <div>
              <p class="text-xs font-bold text-muted uppercase tracking-wider">Total FAQ</p>
              <p class="text-3xl font-black text-ink mt-1 font-mono"><%= stats.faqs %></p>
            </div>
            <div class="w-12 h-12 border border-hairline flex items-center justify-center bg-stone">
              <svg class="w-6 h-6 text-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
            </div>
          </div>
        </div>
      </div>

      <!-- Quick Actions -->
      <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-4 mb-10">
        <a href="/admin/gallery/create" class="bg-milk p-6 border border-hairline hover:border-ink transition-all group flex flex-col">
          <div class="w-12 h-12 border border-hairline flex items-center justify-center bg-stone mb-4 group-hover:border-ink transition-all">
            <svg class="w-6 h-6 text-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
          </div>
          <h3 class="text-lg font-semibold text-ink mb-1">Tambah Galeri</h3>
          <p class="text-sm text-muted">Upload foto/video portofolio baru</p>
        </a>

        <a href="/admin/pricing/create" class="bg-milk p-6 border border-hairline hover:border-ink transition-all group flex flex-col">
          <div class="w-12 h-12 border border-hairline flex items-center justify-center bg-stone mb-4 group-hover:border-ink transition-all">
            <svg class="w-6 h-6 text-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3-.895 3-2-1.343-2-3-2z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16"></path></svg>
          </div>
          <h3 class="text-lg font-semibold text-ink mb-1">Tambah Paket</h3>
          <p class="text-sm text-muted">Buat pricelist paket layanan baru</p>
        </a>

        <a href="/admin/testimonials/create" class="bg-milk p-6 border border-hairline hover:border-ink transition-all group flex flex-col">
          <div class="w-12 h-12 border border-hairline flex items-center justify-center bg-stone mb-4 group-hover:border-ink transition-all">
            <svg class="w-6 h-6 text-ink" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.690h3.462c.969 0 1.371 1.24.588 1.810l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.690l1.07-3.292z"/></svg>
          </div>
          <h3 class="text-lg font-semibold text-ink mb-1">Tambah Testimoni</h3>
          <p class="text-sm text-muted">Kelola review klien</p>
        </a>

        <a href="/admin/faqs" class="bg-milk p-6 border border-hairline hover:border-ink transition-all group flex flex-col">
          <div class="w-12 h-12 border border-hairline flex items-center justify-center bg-stone mb-4 group-hover:border-ink transition-all">
            <svg class="w-6 h-6 text-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
          </div>
          <h3 class="text-lg font-semibold text-ink mb-1">Kelola FAQ</h3>
          <p class="text-sm text-muted">Pertanyaan yang sering diajukan</p>
        </a>
      </div>

      <!-- Quick Links -->
      <div class="pt-8 border-t border-hairline">
        <h2 class="text-xl font-semibold text-ink mb-6">Daftar Lengkap</h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
          <a href="/admin/gallery" class="bg-milk p-4 border border-hairline hover:border-ink transition-all flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 border border-hairline flex items-center justify-center bg-stone">
                <svg class="w-5 h-5 text-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
              </div>
              <div>
                <p class="font-medium text-ink">Kelola Galeri</p>
                <p class="text-xs text-muted"><%= stats.galleries %> item</p>
              </div>
            </div>
            <svg class="w-5 h-5 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </a>

          <a href="/admin/pricing" class="bg-milk p-4 border border-hairline hover:border-ink transition-all flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 border border-hairline flex items-center justify-center bg-stone">
                <svg class="w-5 h-5 text-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8c-1.657 0-3 .895-3 2s1.343 2 3 2 3-.895 3-2-1.343-2-3-2z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 21V5a2 2 0 00-2-2H7a2 2 0 00-2 2v16"></path></svg>
              </div>
              <div>
                <p class="font-medium text-ink">Kelola Pricelist</p>
                <p class="text-xs text-muted"><%= stats.packages %> item</p>
              </div>
            </div>
            <svg class="w-5 h-5 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </a>

          <a href="/admin/testimonials" class="bg-milk p-4 border border-hairline hover:border-ink transition-all flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 border border-hairline flex items-center justify-center bg-stone">
                <svg class="w-5 h-5 text-ink" fill="currentColor" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.690h3.462c.969 0 1.371 1.24.588 1.810l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.690l1.07-3.292z"/></svg>
              </div>
              <div>
                <p class="font-medium text-ink">Kelola Testimoni</p>
                <p class="text-xs text-muted"><%= stats.testimonials %> item</p>
              </div>
            </div>
            <svg class="w-5 h-5 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </a>

          <a href="/admin/faqs" class="bg-milk p-4 border border-hairline hover:border-ink transition-all flex items-center justify-between">
            <div class="flex items-center gap-3">
              <div class="w-10 h-10 border border-hairline flex items-center justify-center bg-stone">
                <svg class="w-5 h-5 text-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8.228 9c.549-1.165 2.03-2 3.772-2 2.21 0 4 1.343 4 3 0 1.4-1.278 2.575-3.006 2.907-.542.104-.994.54-.994 1.093m0 3h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
              </div>
              <div>
                <p class="font-medium text-ink">Kelola FAQ</p>
                <p class="text-xs text-muted"><%= stats.faqs %> item</p>
              </div>
            </div>
            <svg class="w-5 h-5 text-muted" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 5l7 7-7 7"></path></svg>
          </a>
        </div>
      </div>
    </div>
  </main>
</body>
</html>