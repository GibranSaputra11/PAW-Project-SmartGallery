<%- include('../partials/head', { title: 'Tambah Testimoni - Smart Gallery' }) %>

<body class="bg-street text-paper min-h-screen flex flex-col selection:bg-accent selection:text-street">

  <header class="sticky top-0 z-40 bg-street/90 backdrop-blur-md border-b border-slate-800">
    <div class="max-w-7xl mx-auto px-6 py-4 flex items-center justify-between">
      <a href="/admin/testimonials" class="flex items-center gap-2 group">
        <svg class="w-8 h-8 text-accent group-hover:scale-105 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        <span class="font-display text-2xl tracking-wider text-paper">SMART</span>
      </a>
      <span class="font-script text-accent text-xl -ml-6 -mt-2">Gallery</span>

      <div class="flex items-center gap-4">
        <span class="text-sm text-muted">Admin: <strong class="text-paper"><%= session.username %></strong></span>
        <a href="/admin/testimonials" class="text-muted hover:text-paper transition-colors text-sm">Kembali</a>
        <form action="/auth/logout" method="POST" class="inline">
          <button type="submit" class="text-red-400 hover:text-red-300 text-sm font-medium">Logout</button>
        </form>
      </div>
    </div>
  </header>

  <main class="flex-1 max-w-2xl w-full mx-auto px-6 py-8">
    <div class="mb-8">
      <h1 class="text-3xl font-display uppercase tracking-wide text-paper">Tambah Testimoni Baru</h1>
      <p class="text-muted text-sm mt-1">Tambah review dari klien untuk website</p>
    </div>

    <% if (typeof error !== 'undefined' && error) { %>
      <div class="mb-6 p-4 bg-red-500/10 border border-red-500/30 rounded-xl text-red-400 text-sm flex items-center gap-2">
        <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
        <span><%= error %></span>
      </div>
    <% } %>

    <form method="POST" action="/admin/testimonials/create" class="bg-cardbg rounded-2xl p-8 border border-slate-800 space-y-6">
      <div>
        <label for="clientName" class="block text-sm font-medium text-paper mb-2">Nama Klien *</label>
        <input type="text" id="clientName" name="clientName" required maxlength="100" class="w-full bg-street border border-slate-800 rounded-xl px-4 py-3 text-paper placeholder-muted focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all" placeholder="Contoh: Budi Santoso">
      </div>

      <div>
        <label class="block text-sm font-medium text-paper mb-2">Rating *</label>
        <div class="flex items-center gap-4">
          <% for(let i=1; i<=5; i++) { %>
            <label class="flex items-center gap-2 cursor-pointer">
              <input type="radio" name="rating" value="<%= i %>" <%= i === 5 ? 'checked' : '' %> required class="w-5 h-5 text-accent bg-street border-slate-800 focus:ring-accent/20">
              <div class="flex items-center gap-1 text-accent">
                <svg class="w-5 h-5 fill-current" viewBox="0 0 20 20"><path d="M9.049 2.927c.3-.921 1.603-.921 1.902 0l1.07 3.292a1 1 0 00.95.690h3.462c.969 0 1.371 1.24.588 1.810l-2.8 2.034a1 1 0 00-.364 1.118l1.07 3.292c.3.921-.755 1.688-1.54 1.118l-2.8-2.034a1 1 0 00-1.175 0l-2.8 2.034c-.784.57-1.838-.197-1.539-1.118l1.07-3.292a1 1 0 00-.364-1.118L2.98 8.72c-.783-.57-.38-1.81.588-1.81h3.461a1 1 0 00.951-.690l1.07-3.292z"/></svg>
              </div>
              <span class="text-sm"><%= i %> Bintang</span>
            </label>
          <% } %>
        </div>
      </div>

      <div>
        <label for="message" class="block text-sm font-medium text-paper mb-2">Pesan Testimoni *</label>
        <textarea id="message" name="message" required rows="4" class="w-full bg-street border border-slate-800 rounded-xl px-4 py-3 text-paper placeholder-muted focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all" placeholder="Ceritakan pengalaman Anda dengan layanan Smart Gallery..."></textarea>
      </div>

      <div class="flex gap-4 pt-4 border-t border-slate-800">
        <button type="submit" class="flex-1 bg-accent hover:bg-accent/90 text-street font-bold py-3 px-6 rounded-xl transition-all shadow-sm">
          Simpan Testimoni
        </button>
        <a href="/admin/testimonials" class="flex-1 bg-street hover:bg-slate-800 text-paper font-semibold py-3 px-6 rounded-xl text-center border border-slate-800 transition-colors">
          Batal
        </a>
      </div>
    </form>
  </main>

<%- include('../partials/footer') %>