<%- include('../partials/head', { title: 'Tambah Testimoni - Smart Gallery' }) %>
<%- include('../partials/admin-sidebar') %>

<body class="bg-ivory text-ink min-h-screen">
  <main class="lg:pl-[240px] pt-0 lg:pt-0 min-h-screen">
    <!-- Mobile header handled by admin-sidebar partial -->

    <div class="p-6 lg:p-8 max-w-2xl mx-auto">
      <div class="mb-8">
        <h1 class="text-3xl font-display uppercase tracking-wide text-ink">Tambah Testimoni Baru</h1>
        <p class="text-muted text-sm mt-1">Tambah review dari klien untuk website</p>
      </div>

      <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-6 p-4 bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center gap-2">
          <svg class="w-5 h-5 shrink-0 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          <span><%= error %></span>
        </div>
      <% } %>

      <form method="POST" action="/admin/testimonials/create" class="bg-milk p-8 border border-hairline space-y-6">
        <div>
          <label for="clientName" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-2">Nama Klien *</label>
          <input type="text" id="clientName" name="clientName" required maxlength="100" class="w-full px-4 py-3 bg-alabaster border border-hairline text-ink placeholder-numeral focus:outline-none focus:border-ink transition-all text-sm" placeholder="Contoh: Budi Santoso">
        </div>

        <div>
          <label class="block text-xs font-semibold text-ink uppercase tracking-wider mb-2">Rating *</label>
          <div class="grid grid-cols-2 sm:grid-cols-5 gap-3">
            <% for(let i=1; i<=5; i++) { %>
              <label class="flex items-center gap-2 p-3 bg-alabaster border border-hairline cursor-pointer hover:bg-stone transition-colors">
                <input type="radio" name="rating" value="<%= i %>" <%= i === 5 ? 'checked' : '' %> required class="text-ink focus:ring-0">
                <span class="text-xs font-semibold font-mono"><%= i %> Bintang</span>
              </label>
            <% } %>
          </div>
        </div>

        <div>
          <label for="message" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-2">Pesan Testimoni *</label>
          <textarea id="message" name="message" required rows="4" class="w-full px-4 py-3 bg-alabaster border border-hairline text-ink placeholder-numeral focus:outline-none focus:border-ink transition-all text-sm" placeholder="Ceritakan pengalaman Anda dengan layanan Smart Gallery..."></textarea>
        </div>

        <div class="flex gap-4 pt-4 border-t border-hairline">
          <button type="submit" class="flex-1 bg-ink hover:bg-charcoal text-milk font-semibold py-3.5 px-6 transition-all text-sm border border-ink">
            Simpan Testimoni
          </button>
          <a href="/admin/testimonials" class="flex-1 bg-milk hover:bg-stone text-ink font-semibold py-3.5 px-6 text-center border border-hairline transition-colors">
            Batal
          </a>
        </div>
      </form>
    </div>
  </main>
</body>
</html>