<%- include('../partials/head', { title: 'Kelola Galeri - Smart Gallery' }) %>
<%- include('../partials/admin-sidebar') %>

<body class="bg-ivory text-ink min-h-screen">
  <main class="lg:pl-[240px] pt-0 lg:pt-0 min-h-screen">
    <!-- Mobile header handled by admin-sidebar partial -->

    <div class="p-6 lg:p-8 max-w-7xl mx-auto">
      <div class="flex flex-col sm:flex-row sm:items-center sm:justify-between gap-4 mb-8">
        <div>
          <h1 class="text-3xl font-display uppercase tracking-wide text-ink">Kelola Galeri</h1>
          <p class="text-muted text-sm mt-1">Kelola foto/video portofolio untuk website</p>
        </div>
        <a href="/admin/gallery/create" class="bg-ink hover:bg-ink/90 text-ivory font-bold px-6 py-3 transition-all flex items-center justify-center gap-2 shadow-sm">
          <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
          <span>Tambah Galeri Baru</span>
        </a>
      </div>

      <% if (typeof message !== 'undefined' && message) { %>
        <div class="mb-6 p-4 bg-emerald-50 border border-emerald-200 text-emerald-800 text-sm flex items-center gap-2">
          <svg class="w-5 h-5 shrink-0 text-emerald-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 13l4 4L19 7"></path></svg>
          <span><%= message %></span>
        </div>
      <% } %>
      <% if (typeof error !== 'undefined' && error) { %>
        <div class="mb-6 p-4 bg-rose-50 border border-rose-200 text-rose-800 text-sm flex items-center gap-2">
          <svg class="w-5 h-5 shrink-0 text-rose-600" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          <span><%= error %></span>
        </div>
      <% } %>

      <div class="bg-milk border border-hairline overflow-hidden">
        <% if (galleries.length === 0) { %>
          <div class="text-center py-20 px-4">
            <svg class="w-16 h-16 mx-auto text-muted/30 mb-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z"></path></svg>
            <h3 class="text-xl font-semibold text-ink mb-2">Belum Ada Galeri</h3>
            <p class="text-muted mb-6 text-sm">Mulai tambahkan foto atau video portofolio pertama Anda.</p>
            <a href="/admin/gallery/create" class="bg-ink hover:bg-ink/90 text-ivory font-bold px-6 py-3 transition-all inline-flex items-center gap-2">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
              <span>Tambah Galeri Pertama</span>
            </a>
          </div>
        <% } else { %>
          <div class="overflow-x-auto">
            <table class="w-full text-left border-collapse">
              <thead class="bg-stone border-b border-hairline">
                <tr>
                  <th class="px-6 py-4 text-xs font-bold text-muted uppercase tracking-wider">Thumbnail</th>
                  <th class="px-6 py-4 text-xs font-bold text-muted uppercase tracking-wider">Judul</th>
                  <th class="px-6 py-4 text-xs font-bold text-muted uppercase tracking-wider">Kategori</th>
                  <th class="px-6 py-4 text-xs font-bold text-muted uppercase tracking-wider">Tipe</th>
                  <th class="px-6 py-4 text-xs font-bold text-muted uppercase tracking-wider">Tanggal Acara</th>
                  <th class="px-6 py-4 text-xs font-bold text-muted uppercase tracking-wider">Aksi</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-hairline">
                <% galleries.forEach(function(gallery) { %>
                  <tr class="hover:bg-stone/50 transition-colors">
                    <td class="px-6 py-4">
                      <img src="<%= gallery.imageUrl %>" alt="<%= gallery.title %>" class="w-16 h-16 object-cover border border-hairline">
                    </td>
                    <td class="px-6 py-4">
                      <p class="font-medium text-ink"><%= gallery.title %></p>
                      <% if (gallery.videoUrl) { %>
                        <a href="<%= gallery.videoUrl %>" target="_blank" class="text-xs text-ink hover:underline flex items-center gap-1 mt-1 font-mono">
                          <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.752 11.168l-3.197-2.132A1 1 0 0010 9.87v4.263a1 1 0 001.555.832l3.197-2.132a1 1 0 000-1.664z"></path><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 12a9 9 0 11-18 0 9 9 0 0118 0z"></path></svg>
                          <span>Video</span>
                        </a>
                      <% } %>
                    </td>
                    <td class="px-6 py-4">
                      <span class="text-xs font-semibold px-2.5 py-1 bg-stone border border-hairline text-ink"><%= gallery.category %></span>
                    </td>
                    <td class="px-6 py-4">
                      <span class="text-sm text-muted capitalize"><%= gallery.type %></span>
                    </td>
                    <td class="px-6 py-4 text-sm text-muted font-mono">
                      <%= gallery.eventDate ? new Date(gallery.eventDate).toLocaleDateString('id-ID', { day: 'numeric', month: 'short', year: 'numeric' }) : '-' %>
                    </td>
                    <td class="px-6 py-4">
                      <form action="/admin/gallery/<%= gallery.id %>/delete" method="POST" class="inline" onsubmit="return confirm('Yakin hapus galeri ini?')">
                        <button type="submit" class="text-rose-600 hover:text-rose-800 text-sm font-medium flex items-center gap-1 transition-colors">
                          <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v12m-6 0h12a2 2 0 002-2V7a2 2 0 00-2-2H7"></path></svg>
                          <span>Hapus</span>
                        </button>
                      </form>
                    </td>
                  </tr>
                <% }); %>
              </tbody>
            </table>
          </div>
        <% } %>
      </div>
    </div>
  </main>
</body>
</html>