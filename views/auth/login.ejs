<%- include('partials/head', { title: 'Login Admin - Smart Gallery' }) %>

<body class="bg-ivory text-ink min-h-screen flex items-center justify-center px-4 py-16">

  <div class="w-full max-w-[400px]">
    <div class="text-center mb-8">
      <a href="/" class="inline-flex items-center gap-2 group mb-4">
        <svg class="w-10 h-10 text-ink group-hover:scale-105 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        <span class="font-display text-2xl tracking-wider text-ink">SMART</span>
      </a>
      <span class="font-script text-muted text-xl -ml-6 -mt-2 block">Gallery</span>
      <h1 class="mt-6 text-2xl font-display uppercase tracking-wide text-ink">Masuk Dasbor Admin</h1>
      <p class="text-muted text-xs mt-2 leading-relaxed">Masukkan kredensial pemilik untuk mengelola portofolio dan harga paket.</p>
    </div>

    <div class="bg-milk p-8 border border-hairline">
      <% if (error) { %>
        <div class="mb-6 p-4 bg-stone border border-ink text-ink text-xs flex items-center gap-2 animate-shake">
          <svg class="w-4 h-4 shrink-0 text-ink" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path></svg>
          <span><%= error %></span>
        </div>
      <% } %>

      <form method="POST" action="/auth/login" class="space-y-5">
        <div>
          <label for="username" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-2">Username</label>
          <input type="text" id="username" name="username" required autocomplete="username" class="w-full px-4 py-3 bg-alabaster border border-hairline text-ink placeholder-numeral focus:outline-none focus:border-ink transition-all text-sm" placeholder="Masukkan username">
        </div>

        <div>
          <label for="password" class="block text-xs font-semibold text-ink uppercase tracking-wider mb-2">Password</label>
          <input type="password" id="password" name="password" required autocomplete="current-password" class="w-full px-4 py-3 bg-alabaster border border-hairline text-ink placeholder-numeral focus:outline-none focus:border-ink transition-all text-sm" placeholder="Masukkan password">
        </div>

        <button type="submit" class="w-full bg-ink hover:bg-charcoal text-milk font-semibold py-3.5 px-6 transition-all text-sm border border-ink mt-2">
          Masuk
        </button>
      </form>

      <div class="mt-8 pt-6 border-t border-hairline text-center">
        <p class="text-xs text-muted">
          Hanya untuk pemilik jasa Smart Gallery
        </p>
      </div>
    </div>

    <div class="text-center mt-6">
      <a href="/" class="text-muted hover:text-ink text-xs transition-colors inline-flex items-center justify-center gap-1">
        <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
        Kembali ke Galeri
      </a>
    </div>
  </div>

  <style>
    @keyframes shake {
      0%, 100% { transform: translateX(0); }
      10%, 30%, 50%, 70%, 90% { transform: translateX(-4px); }
      20%, 40%, 60%, 80% { transform: translateX(4px); }
    }
    .animate-shake { animation: shake 0.5s ease-in-out; }
  </style>

</body>
</html>