<%- include('partials/head', { title: 'Login Admin - Smart Gallery' }) %>

<body class="bg-street text-paper min-h-screen flex items-center justify-center px-4 py-16 selection:bg-accent selection:text-street">

  <div class="w-full max-w-md">
    <div class="text-center mb-10">
      <a href="/" class="inline-flex items-center gap-2 group mb-6">
        <svg class="w-10 h-10 text-accent group-hover:scale-105 transition-transform" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M3 9a2 2 0 012-2h.93a2 2 0 001.664-.89l.812-1.22A2 2 0 0110.07 4h3.86a2 2 0 011.664.89l.812 1.22A2 2 0 0018.07 7H19a2 2 0 012 2v9a2 2 0 01-2 2H5a2 2 0 01-2-2V9z"></path>
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 13a3 3 0 11-6 0 3 3 0 016 0z"></path>
        </svg>
        <span class="font-display text-3xl tracking-wider text-paper">SMART</span>
      </a>
      <span class="font-script text-accent text-2xl -ml-8 -mt-1">Gallery</span>
      <h1 class="mt-8 text-2xl font-display uppercase tracking-wide text-paper">Admin Login</h1>
      <p class="text-muted text-sm mt-2">Masuk ke dashboard untuk mengelola konten</p>
    </div>

    <div class="bg-cardbg rounded-3xl p-8 border border-slate-800 shadow-2xl">
      <% if (error) { %>
        <div class="mb-6 p-4 bg-red-500/10 border border-red-500/30 rounded-xl text-red-400 text-sm flex items-center gap-2">
          <svg class="w-5 h-5 shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01m-6.938 4h13.856c1.54 0 2.502-1.667 1.732-3L13.732 4c-.77-1.333-2.694-1.333-3.464 0L3.34 16c-.77 1.333.192 3 1.732 3z"></path></svg>
          <span><%= error %></span>
        </div>
      <% } %>

      <form method="POST" action="/auth/login" class="space-y-5">
        <div>
          <label for="username" class="block text-sm font-medium text-paper mb-2">Username</label>
          <input type="text" id="username" name="username" required autocomplete="username" class="w-full bg-street border border-slate-800 rounded-xl px-4 py-3 text-paper placeholder-muted focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all" placeholder="Masukkan username">
        </div>

        <div>
          <label for="password" class="block text-sm font-medium text-paper mb-2">Password</label>
          <input type="password" id="password" name="password" required autocomplete="current-password" class="w-full bg-street border border-slate-800 rounded-xl px-4 py-3 text-paper placeholder-muted focus:outline-none focus:border-accent focus:ring-2 focus:ring-accent/20 transition-all" placeholder="Masukkan password">
        </div>

        <button type="submit" class="w-full bg-accent hover:bg-accent/90 text-street font-bold py-3 px-6 rounded-xl transition-all shadow-sm mt-2">
          Masuk ke Dashboard
        </button>
      </form>

      <p class="mt-6 text-center text-sm text-muted">
        Belum punya akun? <a href="/auth/register" class="text-accent hover:underline font-medium">Daftar di sini</a>
      </p>
    </div>
  </div>

</body>
</html>