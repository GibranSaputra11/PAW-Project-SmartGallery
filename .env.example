# Database
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smartGallery
DB_USER=postgres
DB_PASS=your_password

# Session
SESSION_SECRET=smartgallery_secret

# =====================
# AI CONFIGURATION (Universal - pilih salah satu provider)
# =====================

# Provider: 'gemini' | 'openrouter' | 'openai'
AI_PROVIDER=openrouter

# --- OpenRouter (default, support banyak model gratis/berbayar) ---
OPENROUTER_API_KEY=sk-or-xxxxxxxxxxxx
OPENROUTER_MODEL=nvidia/nemotron-3.5-super-vl:free
# Model gratis populer lain:
# - google/gemini-2.0-flash-exp:free
# - meta-llama/llama-3.2-3b-instruct:free
# - mistralai/mistral-7b-instruct:free

# --- Google Gemini ---
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# --- OpenAI / Compatible (OpenAI, Groq, Together, dll) ---
OPENAI_API_KEY=sk-xxxxxxxxxxxx
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Store Name
STORE_NAME=Smart Gallery